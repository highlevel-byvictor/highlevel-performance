 .svc{padding:20px 0 100px}
 .svc-head{flex-direction:column;align-items:flex-start;gap:22px;margin-bottom:40px}
 .svc-grid{grid-template-columns:1fr}
 .svc-media{display:none}
 .svc-list li{padding:28px 0 34px 0}
 .svc-list li::before{position:static;display:block;margin-bottom:12px}
 .svc-list .mi{display:block;aspect-ratio:4/3;border-radius:28px;overflow:hidden;margin-bottom:22px}
 .svc-list .mi img{width:100%;height:100%;object-fit:cover}
 .svc-list li.on h3{transform:none}
 .sig-sec,.team,.ct{padding:110px 0}
 .sig-in,.story-in,.team-in,.ct-in{grid-template-columns:1fr}
 .oval-w{max-width:330px}.oval-w .tag{right:-4%;width:96px;height:96px;font-size:16px}
 .rev{padding:110px 0 100px}
 .quotes{min-height:330px}
 .story{padding:40px 0 110px}
 .story-img{gap:16px}.story-img figure:first-child{margin-bottom:50px}
 .story-img figcaption{font-size:12.5px;letter-spacing:.1em}.story-img figcaption em{display:block;margin-bottom:6px}
 .team-pic{max-width:400px}.team-pic .deco{inset:-14px 14px 14px -14px}
 .flow{padding:100px 0}
 .flow h2{margin-bottom:50px}
 .flow-line{display:none}
 .flow ol{grid-template-columns:1fr;gap:34px;text-align:left}
 .flow li{flex-direction:row;align-items:flex-start;gap:22px}
 .flow li:nth-child(even){margin-top:0}
 .flow li .dot{width:64px;height:64px;font-size:22px;margin:0;flex:none}
 .flow li div{align-items:flex-start}
 .form{padding:34px 24px 28px;border-radius:32px}
 footer{padding:70px 0 150px}
 footer .wrap{grid-template-columns:1fr}
 .pv{bottom:60px;padding:8px 44px 8px 14px;font-size:13.5px;text-align:left}
 .robo{bottom:112px;right:10px}.robo-av{width:62px;height:74px}
 .robo-say{margin-bottom:40px}
 .bot{bottom:190px;right:12px}

 /* Varianten am Handy */
 .h-left .h-por{order:0}
 .h-left .hero .wrap,.h-center .hero .wrap,.h-full .hero .wrap{grid-template-columns:1fr}
 .h-center .hero h1{font-size:clamp(36px,10.4vw,60px)}
 .seal{display:none}
 .h-por{overflow:hidden}
 .h-center .h-side{padding:6px 0 30px;text-align:left}
 .h-center .hs-score b{font-size:56px}
 .h-full .hero-wash{background:linear-gradient(180deg,color-mix(in srgb,var(--bg) 92%,transparent) 0%,color-mix(in srgb,var(--bg) 80%,transparent) 50%,color-mix(in srgb,var(--bg) 40%,transparent) 75%,var(--bg) 100%)}
 .h-full .h-por{height:auto}
 .h-full .h-txt:last-child{padding-bottom:90px}
 .rb-w{margin:-10px 0 0}
 .counters{padding:80px 0}.ct-intro{margin-bottom:40px}
 .cn-row{grid-template-columns:1fr 1fr;gap:26px 10px}.cn+.cn{border-left:0}
 .svc-mosaic{grid-template-columns:1fr}.tile,.tile:nth-child(n){grid-column:auto;grid-row:auto}.tile .ti,.tile:nth-child(n) .ti{aspect-ratio:4/3;min-height:0}
 .svc-banner{aspect-ratio:4/3;margin-bottom:40px}
 .svc-cols{grid-template-columns:1fr;gap:36px}
 .zz{grid-template-columns:1fr;gap:22px}.zz:nth-child(even) .zz-img{order:0}.zz-img{aspect-ratio:4/3}
 .svc-menu{padding:30px 20px}.svc-menu ul{grid-template-columns:1fr;gap:28px}.svc-menu li{grid-template-columns:68px 1fr;gap:16px}.mn-img{width:68px;height:68px}
 .rv-split{grid-template-columns:1fr;gap:30px}.rs-l{position:static}
 /* neue Hero-Formen am Handy */
 .h-split .hero .wrap,.side-left.h-split .hero .wrap,.h-stage .hero .wrap,.h-slides .hero .wrap{grid-template-columns:1fr}
 .side-left.h-split .h-txt{grid-column:auto;padding-left:0}
 .h-split .h-media{order:-1;margin:6px 0 34px}
 .sh-bleed{position:relative!important;width:auto;height:62svh;margin:0 -22px 34px!important;top:auto!important;bottom:auto!important}
 .sh-bleed .hm-main{border-radius:0 0 calc(var(--r) * 1.4) calc(var(--r) * 1.4)!important}
 .sh-bleed .hm-inset{display:none}
 .h-split:has(.sh-bleed) .hero .wrap{padding-top:0}
 .h-split:has(.sh-bleed) .hero{padding-top:78px}
 .sh-frame::before{inset:-12px 12px 12px -12px;width:auto}.sh-frame .hm-main{width:100%}.sh-frame .hm-inset{width:30%;left:-4%}
 .sh-arch .hm-inset{left:-2%}
 .sh-wide .hm-inset,.sh-tilt .hm-inset{left:-4%;bottom:-14%;width:42%}
 .sh-tilt::before{inset:-12px -8px 12px 14px}
 .sh-wide .hm-badge,.sh-tilt .hm-badge{width:100px;height:100px;right:-6px;top:-30px}.hm-badge b{font-size:22px}.hm-badge span{font-size:10.5px}
 .h-split .h-media:has(.hm-inset) {margin-bottom:60px}
 .h-stage .h-por{height:auto;order:-1;margin-top:0}
 .h-stage .h-por>img{width:min(86vw,420px)}
 .h-stage .h-por .halo{top:8%;width:84%}.h-stage .h-por .ring{top:5%;width:92%}
 .h-slides .hero{min-height:0}
 .h-slides .hero-bg{bottom:auto;height:60svh}
 .h-slides .hero-wash{bottom:auto;height:60svh;background:linear-gradient(180deg,color-mix(in srgb,var(--ink) 30%,transparent),transparent 30%)}
 .h-full .hero-bg.part{left:0!important;-webkit-mask-image:none;mask-image:none}
 .h-slides .hero .wrap{padding-top:52svh;padding-bottom:70px}
 .h-slides .h-txt{padding:26px 22px}
 .mb-in{grid-template-columns:1fr!important}.mb-f{height:260px}.mb-n3 .mb-f:nth-child(2){transform:none}.mb-n3 .mb-f:nth-child(3){display:none}
 .mb-card{margin-top:-50px;padding:26px 20px 28px}
 .pdiv{width:calc(100% - 44px);height:48px}
 .sbar .ad{display:none}.sbar{font-size:13px}body.has-sbar .hero .wrap{padding-top:130px}
 .svc-cards{grid-template-columns:1fr}
 .t3{grid-template-columns:1fr;gap:40px}.t3 .ph{max-width:340px}
 .svid-in{grid-template-columns:1fr}.svid-f{width:min(300px,80vw)}

 .map{padding:70px 0 80px}.map-in{height:auto;display:flex;flex-direction:column}.map-in>img{position:relative;height:280px}.map-in::after{display:none}.map-pin{top:140px}
 .map-card{position:relative;left:auto;top:auto;transform:none;width:auto;margin:0;border-radius:0;box-shadow:none;padding:26px 22px 40px;z-index:3}
 .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:55;background:var(--ink);padding-bottom:env(safe-area-inset-bottom)}
 .callbar a{flex:1;display:flex;align-items:center;justify-content:center;gap:10px;padding:18px 10px;color:#fff;text-decoration:none;font:500 16.5px var(--fb);letter-spacing:.04em}
 .callbar a+a{background:var(--grad)}
 .callbar svg{width:18px;height:18px}
}
</style>
</head>
<body class="h-{{ HERO }}{% if HERO == 'stage' %} h-center{% endif %}{% if HS %} side-{{ HS.get('side','right') }}{% endif %}{% if B.get('slides') %} h-slides{% endif %} pat-{{ B.get('pattern','petals') }}{% if B.get('social') %} has-sbar{% endif %} s-{{ B.get('svc_layout','arch') }} r-{{ B.get('rev_layout','single') }}{% if B.get('dark') %} dark{% endif %}">
{%- set star = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8z"/></svg>' -%}
{%- set check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>' -%}
{%- set EP = {'wave':'M0 52C180 18 360 6 560 30s380 58 560 46 260-38 320-48V90H0z','arc':'M0 90C360 6 1080 6 1440 90z','slant':'M0 90L1440 14V90z','scallop':'M0 90V58' ~ ('a30 30 0 0 1 60 0' * 24) ~ 'V90z','double':'M0 60C240 30 480 30 720 60s480 30 720 0V90H0z'} -%}
{%- set wave = '<svg viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="' ~ EP.get(EDGE, EP.wave) ~ '"/></svg>' -%}

{% if B.get('social') %}<div class="sbar" id="sbar"><div class="wrap"><a href="tel:{{ f.tel_link }}">{{ icon_phone }}{{ f.telefon }}</a><span class="ad">{{ f.adresse }}</span><span class="so">{% for n,u in B.social %}<a href="{{ u }}" target="_blank" rel="noopener" aria-label="{{ n|capitalize }}">{{ SOC_IC[n] | safe }}</a>{% endfor %}</span></div></div>{% endif %}
{% set svid_html %}{% set SV = B.get('studio_video') or {} %}<section class="svid{% if SV.get('wide') %} wide{% endif %}" id="studio"><div class="wrap svid-in">
 <div class="svid-f rv"><video autoplay muted loop playsinline preload="metadata"{% if SV.get('poster') %} poster="{{ SV.poster }}"{% endif %} aria-label="{{ SV.get('alt','Imagevideo') }}"><source src="{{ SV.src }}" type="video/mp4"></video></div>
 <div><span class="eyebrow rv">{{ SV.eyebrow }}</span><h2 class="rv d1">{{ SV.h2 | safe }}</h2><p class="lead rv d2">{{ SV.p }}</p><a class="btn btn-p rv d3" href="#kontakt" style="margin-top:34px">{{ B.cta_btn }}</a></div>
</div></section>{% endset %}
<header class="top" id="top"><div class="wrap">
 {% if f.logo %}<a class="wm wm-logo" href="#"><img src="{{ f.logo }}" alt="{{ f.kurzname }}"></a>{% else %}<a class="wm{% if B.get('logo_badge') %} wm-b{% endif %}" href="#">{% if B.get('logo_badge') %}<img src="{{ B.logo_badge }}" alt="" class="wm-badge">{% endif %}<span><b>{{ B.wm[0] }} <i>{{ B.wm[1] }}</i></b><small>{{ B.wm_sub }}</small></span></a>{% endif %}
 <nav class="nav">{% for n in B.get("nav", [["leistungen","Behandlungen"],["bewertungen","Bewertungen"],["ueber","Team"],["kontakt","Kontakt"]]) %}<a href="#{{ n[0] }}">{{ n[1] }}</a>{% endfor %}</nav>
 <a class="btn btn-p" href="#kontakt">{{ B.cta_btn }}</a>
</div></header>

<section class="hero" aria-label="Willkommen">
 {% if HERO in ('split','stage') %}<div class="hero-pat" aria-hidden="true"></div>
 {% elif HERO == 'full' and B.get('slides') %}{% for k in B.slides %}<div class="hero-bg hs-s{% if loop.first %} on{% endif %}" role="img" aria-label="{{ B.hero_bg_alt }}" style="background-image:url('{{ I[k] }}');background-position:{{ B.pos.get(k, '50% 50%') }}"></div>{% endfor %}<div class="hero-wash"></div>
 {% else %}<div class="hero-bg{% if B.get('full_left') %} part{% endif %}" role="img" aria-label="{{ B.hero_bg_alt }}"{% if HERO == 'full' %} style="background-image:url('{{ I[B.full_img] }}');background-position:{{ B.get('full_pos','50% 50%') }}{% if B.get('full_left') %};left:{{ B.full_left }}{% endif %}"{% endif %}></div><div class="hero-wash"></div><div class="liquid a"></div><div class="liquid b"></div>{% endif %}
 <div class="wrap">
  <div class="h-txt">
   <span class="eyebrow h-load">{{ B.eyebrow }}</span>
   <h1 class="h-load d1">{{ B.h1 | safe }}</h1>
   <p class="lead h-load d2">{{ B.sub }}</p>
   <div class="h-cta h-load d3"><a class="btn btn-p" href="#kontakt">{{ B.cta_btn }}</a><a class="btn btn-g" href="#leistungen">{{ B.cta2 }}</a></div>
   {% if HERO not in ('center','stage') %}<div class="h-proof h-load d4">
    {% if f.google %}<div class="g"><b>{{ f.google[0] }} <span class="stars">{% for _ in range(5) %}{{ star | safe }}{% endfor %}</span></b>{{ f.google[1] }} Google-Bewertungen</div><span class="sep"></span>{% endif %}
    <span class="sg">{{ B.proof_txt }}</span>
   </div>{% endif %}
  </div>
  {% if HERO == 'split' %}<div class="h-media h-load sh-{{ HS.get('shape','frame') }}">
   <div class="hm-main">{% for k in HS.imgs %}{% if B.get("steam_on", {}).get(k) %}<span class="stw{% if loop.first %} on{% endif %}" data-k="{{ loop.index0 }}">{{ steam(B.steam_on[k]) }}</span>{% endif %}{% endfor %}{% for k in HS.imgs %}<img class="hm-s{% if loop.first %} on{% endif %}" src="{{ I[k] }}" alt="{{ HS.get('alt', f.kurzname) }}"{% if B.pos.get(k) %} style="object-position:{{ B.pos.get(k) }}"{% endif %}{% if not loop.first %} loading="lazy"{% else %} fetchpriority="high"{% endif %} decoding="async">{% endfor %}</div>
   {% if HS.get('inset') %}<div class="hm-inset">{{ im(HS.inset, HS.get('inset_alt', f.kurzname), eager=True) }}</div>{% endif %}
   {% if HS.get('badge') %}<div class="hm-badge"><b>{{ HS.badge[0] }}</b><span>{{ HS.badge[1] }}</span></div>{% endif %}
   {% if HS.get('caps') %}<div class="hm-cap">{% for c in HS.caps %}<p class="hc{% if loop.first %} on{% endif %}"><small>{{ c[0] }}</small><b>{{ c[1] }}</b></p>{% endfor %}</div>{% endif %}
   {% if HS.imgs | length > 1 %}<div class="hm-dots" aria-hidden="true">{% for k in HS.imgs %}<i{% if loop.first %} class="on"{% endif %}></i>{% endfor %}</div>{% endif %}
  </div>
  {% elif not (HERO == 'full' and not f.cutout) %}<div class="h-por h-load">
   <span class="halo"{% if B.get('halo_top') %} style="top:{{ B.halo_top }}"{% endif %}></span><span class="ring"{% if B.get('halo_top') %} style="top:calc({{ B.halo_top }} - 3%)"{% endif %}></span>
   {% if f.cutout and HERO != 'full-nocut' %}<img src="{{ f.cutout }}" alt="{{ B.cut_alt }}" width="{{ f.cut_w }}" height="{{ f.cut_h }}" fetchpriority="high">{% else %}<div class="h-arch">{{ im(B.hero_img, B.get('hero_img_alt', f.kurzname), eager=True) }}</div>{% endif %}
   {% if B.get('chip') %}<div class="chip"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M12 3c3 4 6 7.2 6 10.5a6 6 0 0 1-12 0C6 10.2 9 7 12 3z"/></svg></i><div><b>{{ B.chip[0] }}</b><span>{{ B.chip[1] }}</span></div></div>{% endif %}
   {% if B.get('seal') %}<div class="seal{% if B.get("seal_pos") == "br" %} br{% endif %}" aria-label="{{ B.seal }}"><svg viewBox="0 0 128 128" aria-hidden="true"><defs><path id="sc" d="M64 64m-49 0a49 49 0 1 1 98 0a49 49 0 1 1-98 0"/></defs><text><textPath href="#sc">{{ B.seal }}</textPath></text></svg><b>{{ B.seal_mono }}</b></div>{% endif %}
  </div>{% endif %}
  {% if HERO in ('center','stage') %}<div class="h-side h-load d3">
   {% if f.google %}<div class="hs-score"><b>{{ f.google[0] }}</b><span class="stars">{% for _ in range(5) %}{{ star | safe }}{% endfor %}</span><small>{{ f.google[1] }} Google-Bewertungen</small></div>{% endif %}
   <p>{{ B.proof_txt }}</p>
   {% if B.get('side_extra') %}<p class="hs-x">{{ B.side_extra | safe }}</p>{% endif %}
  </div>{% endif %}
 </div>
 <div class="h-wave">{{ wave | safe }}</div>
</section>

{% if B.get('studio_video') and B.studio_video.get('top', True) %}{{ svid_html }}{% endif %}
{% if B.get('ribbon') %}<div class="rb-w"><div class="ribbon" aria-hidden="true"><div class="rb-in">{% for _ in range(4) %}{% for t in B.ribbon %}<span>{{ t }}</span><i>✦</i>{% endfor %}{% endfor %}</div></div></div>{% endif %}
{% if B.get('counters') %}<section class="counters"><div class="wrap">
 <p class="ct-intro rv">{{ B.intro | safe }}</p>
 <div class="cn-row">{% for n in B.counters %}<div class="cn rv d{{ loop.index0 % 3 + 1 }}"><b>{{ n[0] }}</b><span>{{ n[1] }}</span></div>{% endfor %}</div>
</div></section>{% else %}<section class="intro"><div class="wrap">
 <span class="orn rv"></span>
 <p class="rv">{{ B.intro | safe }}</p>
 <div class="sig rv d1">{{ B.intro_sig }}</div>
</div></section>{% endif %}

<div class="pdiv" aria-hidden="true"><span></span></div>
<section class="svc" id="leistungen"><div class="wrap">
 <div class="svc-head">
  <div><span class="eyebrow rv">{{ B.get("svc_eyebrow", "Behandlungen") }}</span><h2 class="rv d1">{{ B.svc_h2 | safe }}</h2></div>
  <p class="lead rv d2">{{ B.svc_intro }}</p>
 </div>
 {% set L = B.get('svc_layout','arch') %}
 {% if L == 'cards' %}<div class="svc-cards">{% for s in B.svc %}<a class="card rv d{{ loop.index0 % 3 + 1 }}" href="#kontakt"><div class="ci">{{ im(s[0], s[1]) }}{% if B.get("steam_on", {}).get(s[0]) %}{{ steam(B.steam_on[s[0]]) }}{% endif %}</div><div><h3>{{ s[1] }}</h3><p>{{ s[2] }}</p><span class="more">{{ B.get('card_more', 'Termin anfragen') }}</span></div></a>{% endfor %}</div>
 {% elif L == 'mosaic' %}<div class="svc-mosaic">{% for s in B.svc %}<figure class="tile rv d{{ loop.index0 % 3 + 1 }}"><div class="ti">{{ im(s[0], s[1]) }}</div><figcaption><span class="no">{{ '%02d' % loop.index }}</span><h3>{{ s[1] }}</h3><p>{{ s[2] }}</p></figcaption></figure>{% endfor %}</div>
 {% elif L == 'cols' %}<div class="svc-banner rv">{{ im(B.get('svc_banner', B.svc[0][0]), B.svc[0][1]) }}</div><ol class="svc-cols">{% for s in B.svc %}<li class="rv d{{ loop.index0 % 3 + 1 }}"><span class="no">{{ '%02d' % loop.index }}</span><h3>{{ s[1] }}</h3><p>{{ s[2] }}</p>{% if s|length > 3 and s[3] %}<div class="tg">{{ s[3] | join(' · ') }}</div>{% endif %}</li>{% endfor %}</ol>
 {% elif L == 'zigzag' %}<div class="svc-zz">{% for s in B.svc %}<article class="zz rv"><div class="zz-img">{{ im(s[0], s[1]) }}</div><div class="zz-txt"><span class="no">{{ '%02d' % loop.index }}</span><h3>{{ s[1] }}</h3><p>{{ s[2] }}</p>{% if s|length > 3 and s[3] %}<div class="tg">{{ s[3] | join(' · ') }}</div>{% endif %}<a class="zz-link" href="#kontakt">{{ B.cta_btn }}</a></div></article>{% endfor %}</div>
 {% elif L == 'menu' %}<div class="svc-menu rv"><div class="mn-head"><span class="mn-orn">✦</span><b>{{ B.get('menu_title', 'Behandlungskarte') }}</b><span class="mn-orn">✦</span></div><ul>{% for s in B.svc %}<li><div class="mn-img">{{ im(s[0], s[1]) }}</div><div><h3><span>{{ s[1] }}</span><i></i>{% if s|length > 3 and s[3] %}<small>{{ s[3][0] }}</small>{% endif %}</h3><p>{{ s[2] }}</p></div></li>{% endfor %}</ul></div>
 {% else %}<div class="svc-grid">
  <div class="svc-media rv" id="svcm">{% for s in B.svc %}<img src="{{ I[s[0]] }}" alt="{{ s[1] }}" data-i="{{ loop.index0 }}"{% if loop.first %} class="on"{% endif %}{% if B.pos.get(s[0]) %} style="object-position:{{ B.pos.get(s[0]) }}"{% endif %} loading="lazy" decoding="async">{% endfor %}</div>
  <ol class="svc-list">{% for s in B.svc %}
   <li class="rv{% if loop.first %} on{% endif %}" data-i="{{ loop.index0 }}"><div class="mi">{{ im(s[0], s[1]) }}</div><h3>{{ s[1] }}</h3><p>{{ s[2] }}</p>{% if s|length > 3 and s[3] %}<div class="tg">{{ s[3] | join(' · ') }}</div>{% endif %}</li>{% endfor %}
  </ol>
 </div>{% endif %}
</div></section>

{% if B.get('signature') %}{% set S = B.signature %}
<section class="sig-sec" id="signatur">
 <div class="wtop">{{ wave | safe }}</div>
 <div class="wrap sig-in">
  <div class="oval-w rv sh-{{ S.get('shape', B.get('sig_shape','oval')) }}"><div class="oval">{{ im(S.img, S.alt) }}</div>{% if S.get('tag') %}<span class="tag">{{ S.tag | safe }}</span>{% endif %}</div>
  <div>
   <span class="eyebrow rv">{{ S.eyebrow }}</span>
   <h2 class="rv d1">{{ S.h2 | safe }}</h2>
   <p class="lead rv d2">{{ S.p }}</p>
   {% if S.get('ritual') %}<ul class="ritual rv d2">{% for r in S.ritual %}<li>{{ r }}</li>{% endfor %}</ul>{% else %}<div style="height:34px"></div>{% endif %}
   {% if S.get('quote') %}<blockquote class="sig-q rv d3"><span class="stars">{% for _ in range(5) %}{{ star | safe }}{% endfor %}</span>„{{ S.quote }}“</blockquote>{% endif %}
   <a class="btn btn-p rv d3" href="#kontakt">{{ S.btn }}</a>
  </div>
 </div>
 <div class="wbot">{{ wave | safe }}</div>
</section>
{% endif %}

{% if B.get('video') or B.get('moment') %}{% set M = B.get('moment') or {} %}{% set MI = M.get('imgs') or ([M.img] if M.get('img') else []) %}
<section class="mband"><div class="wrap">
 <div class="mb-in mb-n{{ (1 if B.get('video') else MI | length) }}"{% if M.get('cols') or M.get('h') %} style="{% if M.get('cols') %}grid-template-columns:{{ M.cols }};{% endif %}{% if M.get('h') %}--mbh:{{ M.h }}{% endif %}"{% endif %}>
  {% if B.get('video') %}<figure class="mb-f"><video autoplay muted loop playsinline preload="metadata"{% if B.video.get('poster') %} poster="{{ I[B.video.poster] }}"{% endif %} aria-hidden="true"><source src="{{ B.video.src }}" type="{{ B.video.get('type', 'video/mp4') }}"></video></figure>
  {% else %}{% for k in MI %}<figure class="mb-f rv d{{ loop.index }}">{{ im(k, M.get('alt', f.kurzname)) }}</figure>{% endfor %}{% endif %}
 </div>
 <div class="mb-card rv d2"><span class="mb-orn" aria-hidden="true"></span><p>{{ (B.video.text if B.get('video') else M.text) | safe }}</p></div>
</div></section>{% endif %}
<section class="rev" id="bewertungen"><div class="wrap">
 {% set RL = B.get('rev_layout','single') %}
 {% if RL == 'split' %}<div class="rv-split"><div class="rs-l rv"><span class="eyebrow">{{ B.rev_eyebrow }}</span><b class="rs-n">{{ f.google[0] }}</b><span class="stars">{% for _ in range(5) %}{{ star | safe }}{% endfor %}</span><small>{{ f.google[1] }} Bewertungen bei Google</small></div>
  <div class="rs-r">{% for r in f.reviews[:3] %}<blockquote class="rv d{{ loop.index }}"><p>{{ r[0] }}</p><cite>Google-Bewertung</cite></blockquote>{% endfor %}</div></div>
 {% elif RL == 'marquee' %}<span class="eyebrow rv">{{ B.rev_eyebrow }}</span>
  {% if f.google %}<div class="score rv d1"><b>{{ f.google[0] }}</b><span><span class="stars">{% for _ in range(5) %}{{ star | safe }}{% endfor %}</span><br>{{ f.google[1] }} Bewertungen<br>bei Google</span></div>{% endif %}
 </div><div class="rv-mq rv"><div class="mq-in">{% for k in range(2) %}{% for r in f.reviews %}<blockquote{% if k %} aria-hidden="true"{% endif %}><span class="stars">{% for _ in range(5) %}{{ star | safe }}{% endfor %}</span><p>{{ r[0] }}</p></blockquote>{% endfor %}{% endfor %}</div></div><div class="wrap">
 {% else %}<span class="eyebrow rv">{{ B.rev_eyebrow }}</span>
 {% if f.google %}<div class="score rv d1"><b>{{ f.google[0] }}</b><span><span class="stars">{% for _ in range(5) %}{{ star | safe }}{% endfor %}</span><br>{{ f.google[1] }} Bewertungen<br>bei Google</span></div>{% endif %}
 <div class="quotes rv d2" id="quotes">{% for r in f.reviews %}<blockquote{% if loop.first %} class="on"{% endif %}><p>{{ r[0] }}</p><cite>Google-Bewertung</cite></blockquote>{% endfor %}</div>
 <div class="qdots" id="qdots">{% for r in f.reviews %}<button type="button" aria-label="Bewertung {{ loop.index }}"{% if loop.first %} class="on"{% endif %}></button>{% endfor %}</div>{% endif %}
</div></section>

<div class="pdiv" aria-hidden="true"><span></span></div>
{% if B.get('story') %}{% set St = B.story %}
<section class="story" id="geschichte"><div class="wrap story-in">
 <div class="story-txt">
  <span class="eyebrow rv">{{ St.eyebrow }}</span>
  <h2 class="rv d1">{{ St.h2 | safe }}</h2>
  {% for p in St.p %}<p class="lead rv d2">{{ p }}</p>{% endfor %}
 </div>
 <div class="story-img">
  <figure class="rv"><div class="arch{% if not St.get('bw', True) %} col{% endif %}">{{ im(St.img1, St.cap1) }}</div><figcaption><em>{{ St.lab1 }}</em>{{ St.cap1 }}</figcaption></figure>
  <figure class="rv d2"><div class="soft">{{ im(St.img2, St.cap2) }}</div><figcaption><em>{{ St.lab2 }}</em>{{ St.cap2 }}</figcaption></figure>
 </div>
</div></section>
{% endif %}

{% if B.get("team_img") %}<section class="team" id="ueber"><div class="wrap team-in">
 <div class="team-pic rv"><div class="ph">{{ im(B.team_img, B.team_alt) }}</div><span class="deco"></span></div>
 <div class="team-txt">
  <span class="eyebrow rv">{{ B.team_eyebrow }}</span>
  <h2 class="rv d1">{{ B.team_h2 | safe }}</h2>
  {% for p in f.ueber %}<p class="lead rv d2">{{ p }}</p>{% endfor %}
  <ul class="checks rv d3">{% for ch in f.checks %}<li><i>{{ check | safe }}</i>{{ ch }}</li>{% endfor %}</ul>
 </div>
</div></section>{% endif %}

{% if B.get('team3') %}{% set T3 = B.team3 %}<section class="team3" id="team"><div class="wrap">
 <span class="eyebrow rv">{{ T3.eyebrow }}</span><h2 class="rv d1">{{ T3.h2 | safe }}</h2>
 <div class="t3" style="--tn:{{ T3.people | length }}">{% for pp in T3.people %}<figure class="rv d{{ loop.index }}"><div class="ph">{{ im(pp[0], pp[1]) }}</div><figcaption>{{ pp[1] }}{% if pp|length > 2 and pp[2] %}<small>{{ pp[2] }}</small>{% endif %}</figcaption></figure>{% endfor %}</div>
</div></section>{% endif %}
{% if B.get('studio_video') and not B.studio_video.get('top', True) %}{{ svid_html }}{% endif %}
<div class="pdiv" aria-hidden="true"><span></span></div>
<section class="flow"><div class="wrap">
 <span class="eyebrow rv">Ablauf</span>
 <h2 class="rv d1">{{ B.steps_h2 | safe }}</h2>
 <div class="flow-in rv" id="flow">
  <svg class="flow-line" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="fg" x1="0" x2="1"><stop offset="0" stop-color="{{ c.acc }}"/><stop offset="1" stop-color="{{ c.champ }}"/></linearGradient></defs><path d="M150 22C300 22 300 68 450 68S600 22 750 22s150 46 300 46"/></svg>
  <ol>{% for st in steps %}<li><span class="dot">{{ loop.index }}</span><div><b>{{ st[0] }}</b><span>{{ st[1] }}</span></div></li>{% endfor %}</ol>
 </div>
</div></section>

<section class="ct" id="kontakt">
 <div class="wtop">{{ wave | safe }}</div>
 <div class="wrap ct-in">
  <div>
   <span class="eyebrow rv">Kontakt</span>
   <h2 class="rv d1">{{ B.cta_h2 | safe }}</h2>
   <p class="lead rv d2">{{ B.cta_p }}</p>
   <a class="tel rv d2" href="tel:{{ f.tel_link }}">{{ f.telefon }}</a>
   <ul class="info rv d3"><li><b>Adresse</b> · {{ f.adresse }}</li>{% for x in B.get('info', []) %}<li>{{ x | safe }}</li>{% endfor %}</ul>
  </div>
  <form class="form rv d1" onsubmit="event.preventDefault();this.querySelector('small').textContent='Danke! Im fertigen System landet {{ 'deine' if du else 'Ihre' }} Anfrage sofort im CRM, mit automatischer Bestätigung. Im Entwurf ist das Formular noch nicht aktiv.'">
   <h3>{{ B.form_h3 }}</h3><p>{{ B.form_p }}</p>
   <label><input aria-label="Name" placeholder="{{ 'Dein Name' if du else 'Ihr Name' }}" autocomplete="name"></label>
   <label><input aria-label="Telefon" placeholder="Telefon" inputmode="tel" autocomplete="tel"></label>
   {% if B.get('form_kind') == 'reserve' %}<div class="f2"><label><input aria-label="Datum" type="date"></label><label><select aria-label="Personen"><option>{{ B.get('form_q', 'Personen') }}</option>{% for n in ['2 Personen','3 Personen','4 Personen','5 Personen','6 Personen','7–10 Personen','Feier ab 10 Personen'] %}<option>{{ n }}</option>{% endfor %}</select></label></div>
   {% else %}<label><select aria-label="Auswahl"><option>{{ B.form_q }}</option>{% for s in B.svc %}<option>{{ s[1] }}</option>{% endfor %}<option>{{ B.get('form_extra', 'Gutschein') }}</option></select></label>{% endif %}
   <button class="btn btn-p" type="submit">{{ B.get('form_btn', 'Rückruf anfordern') }}</button>
   <small>Beispiel-Funktion: Anfragen landen direkt im CRM, mit automatischer Bestätigung.</small>
  </form>
 </div>
</section>

{% if f.karte %}<section class="map" aria-label="Anfahrt"><div class="wrap"><div class="map-in rv">
 <img src="{{ f.karte }}" alt="Karte mit dem Standort von {{ f.kurzname }}" loading="lazy" decoding="async">
 <span class="map-pin" aria-hidden="true"><i></i></span>
 <div class="map-card"><span class="eyebrow">{{ 'So findest du uns' if du else 'So finden Sie uns' }}</span><b>{{ f.kurzname }}</b><p>{{ f.adresse }}</p><a class="btn btn-p" href="https://www.google.com/maps/dir/?api=1&amp;destination={{ (f.kurzname ~ ', ' ~ f.adresse) | urlencode }}" target="_blank" rel="noopener">Route planen</a></div>
 <small class="map-osm">© OpenStreetMap-Mitwirkende</small>
</div></div></section>{% endif %}

<footer><div class="wrap">
 <div>{% if f.logo %}<span class="ft-logo"><img src="{{ f.logo }}" alt="{{ f.kurzname }}"></span>{% else %}<a class="wm" href="#"><b>{{ B.wm[0] }} <i>{{ B.wm[1] }}</i></b><small>{{ B.wm_sub }}</small></a>{% endif %}<p style="margin-top:22px">{{ f.adresse }}</p></div>
 <div><p><a href="tel:{{ f.tel_link }}">{{ f.telefon }}</a>{% if f.email %}<br><a href="mailto:{{ f.email }}">{{ f.email }}</a>{% endif %}</p></div>
 <div><p><a href="#">Impressum</a><br><a href="#">Datenschutz</a></p></div>
 <p class="note">Grober Entwurf von High Level Performance mit Bildern und Texten von {{ f.website_kurz }}. Bei einer Zusammenarbeit wird alles viel intensiver ausgearbeitet.</p>
</div></footer>

<aside class="pv" id="pv"><b>Grober Entwurf</b>Erstellt von High Level Performance. Bei einer Zusammenarbeit arbeiten wir jede Seite viel intensiver aus.<button type="button" aria-label="Hinweis schließen" onclick="this.parentNode.remove()">x</button></aside>
<div class="robo" id="robo"><div class="robo-say" id="rsay" role="status" aria-live="polite"></div><button class="robo-av" type="button" id="botbtn" aria-label="Digitalen Guide öffnen"><svg viewBox="0 0 84 100" aria-hidden="true"><defs><linearGradient id="rg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="{{ c.acc }}"/><stop offset="1" stop-color="{{ c.champ }}"/></linearGradient><linearGradient id="rb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="{{ c.pearl }}"/></linearGradient></defs><line x1="42" y1="8" x2="42" y2="20" stroke="{{ c.acc_d }}" stroke-width="2.4" stroke-linecap="round"/><circle class="ant" cx="42" cy="7" r="5" fill="url(#rg)"/><rect x="9" y="20" width="66" height="52" rx="26" fill="url(#rb)" stroke="{{ c.blush }}" stroke-width="1.5"/><rect x="17" y="30" width="50" height="30" rx="15" fill="{{ c.ink }}"/><ellipse class="eye" cx="32" cy="45" rx="4.6" ry="5.6" fill="url(#rg)"/><ellipse class="eye" cx="52" cy="45" rx="4.6" ry="5.6" fill="url(#rg)"/><path d="M35 53q7 4.5 14 0" stroke="{{ c.champ }}" stroke-width="2.2" fill="none" stroke-linecap="round"/><circle cx="8" cy="46" r="5" fill="url(#rg)"/><circle cx="76" cy="46" r="5" fill="url(#rg)"/><rect x="25" y="72" width="34" height="22" rx="11" fill="url(#rb)" stroke="{{ c.blush }}" stroke-width="1.5"/><circle cx="42" cy="83" r="4" fill="url(#rg)"/><rect class="arm" x="61" y="64" width="9" height="22" rx="4.5" fill="url(#rg)"/></svg></button></div>
<div class="bot" id="bot" role="dialog" aria-label="Assistent">
 <header><div>{{ B.bot_name }}<small>Digitaler Guide von {{ f.kurzname }}, rund um die Uhr</small></div><button type="button" aria-label="Schließen" id="botx">&times;</button></header>
 <div class="msgs" id="msgs"><div class="m">{{ B.bot_hi }}</div></div>
 <div class="chips" id="chips">{% set CH = B.get('chips', ['Welche Behandlungen gibt es?', ('Wo finde ich euch?' if du else 'Wo finde ich Sie?'), 'Termin anfragen']) %}<button type="button" data-a="0">{{ CH[0] }}</button><button type="button" data-a="1">{{ CH[1] }}</button><button type="button" data-a="2">{{ CH[2] }}</button></div>
 <p class="demo">Beispiel-Funktion im Entwurf. Im fertigen System beantwortet der KI-Guide Fragen mit den eigenen Infos {{ B.get('biz_gen', 'des Studios') }} und trägt Anfragen ins CRM ein.</p>
</div>
<div class="callbar"><a href="tel:{{ f.tel_link }}">{{ icon_phone }}Anrufen</a><a href="#kontakt">{{ B.mb_btn }}</a></div>

<script src="../../assets/vendor/lenis.min.js"></script>
<script>
(function(){
var QA=/[?&]qa/.test(location.search);if(QA)document.documentElement.classList.add('qa');
var top=document.getElementById('top');function hd(){top.classList.toggle('solid',scrollY>40);document.body.classList.toggle('sb-hide',scrollY>40)}hd();addEventListener('scroll',hd,{passive:true});
/* Einblenden */
var rv=document.querySelectorAll('.rv');
if(QA||!('IntersectionObserver' in window)){rv.forEach(function(e){e.classList.add('in')})}
else{var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});rv.forEach(function(e){io.observe(e)})}
/* Ablauf-Linie */
var fp=document.querySelector('.flow-line path');if(fp){fp.style.setProperty('--len',Math.ceil(fp.getTotalLength()))}
/* Behandlungen: Bild wechselt weich */
var li=document.querySelectorAll('.svc-list li'),mi=document.querySelectorAll('#svcm img');
function act(i){li.forEach(function(l,k){l.classList.toggle('on',k==i)});mi.forEach(function(m,k){m.classList.toggle('on',k==i)})}
li.forEach(function(l){l.addEventListener('mouseenter',function(){act(+l.dataset.i)})});
if('IntersectionObserver' in window){var io2=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)act(+e.target.dataset.i)})},{rootMargin:'-48% 0px -48% 0px'});li.forEach(function(l){io2.observe(l)})}
/* Hero-Slider (scharfe Fotos, weich überblendet) */
var sl=document.querySelectorAll('.hm-main img,.hs-s'),sd=document.querySelectorAll('.hm-dots i'),sk=0;
window.__slide=function(i){sk=i;sl.forEach(function(e,k){e.classList.toggle('on',k==i)});sd.forEach(function(e,k){e.classList.toggle('on',k==i)});document.querySelectorAll('.hm-cap .hc').forEach(function(e,k){e.classList.toggle('on',k==i)});document.querySelectorAll('.stw').forEach(function(e){e.classList.toggle('on',+e.dataset.k==i)})};
if(!QA&&sl.length>1&&!matchMedia('(prefers-reduced-motion: reduce)').matches)setInterval(function(){__slide((sk+1)%sl.length)},5200);
/* Bewertungen */
var qs=document.querySelectorAll('#quotes blockquote'),qd=document.querySelectorAll('#qdots button'),qk=0,qt;
function q(i){qk=i;qs.forEach(function(b,k){b.classList.toggle('on',k==i)});qd.forEach(function(b,k){b.classList.toggle('on',k==i)})}
function qa(){clearInterval(qt);qt=setInterval(function(){q((qk+1)%qs.length)},7000)}
qd.forEach(function(b,k){b.onclick=function(){q(k);qa()}});if(!QA&&qs.length>1)qa();
/* Weiches Scrollen */
if(!QA&&window.Lenis&&!matchMedia('(prefers-reduced-motion: reduce)').matches){var L=new Lenis({lerp:.085});window.__lenis=L;(function r(t){L.raf(t);requestAnimationFrame(r)})(0);
 document.querySelectorAll('a[href^="#"]').forEach(function(a){a.addEventListener('click',function(e){var id=a.getAttribute('href');if(id.length>1){e.preventDefault();L.scrollTo(id,{offset:-70,duration:1.6})}})})}
/* Guide + Chat */
var bot=document.getElementById('bot'),msgs=document.getElementById('msgs'),robo=document.getElementById('robo'),say=document.getElementById('rsay'),BN={{ B.bot_name | tojson }};
{% if du %}var A=[{{ ('Bei uns bekommst du: ' ~ (B.svc | map(attribute=1) | join(', ')) ~ '.' ~ B.get('a_extra', '')) | tojson }},{{ ('Du findest uns hier: ' ~ f.adresse ~ '. Telefon: ' ~ f.telefon ~ '.') | tojson }},{{ ('Sehr gern! Ruf einfach an unter ' ~ f.telefon ~ ' oder nutze das Formular unten. Wir melden uns schnell zurück.') | tojson }}];
{% else %}var A=[{{ ('Wir bieten Ihnen: ' ~ (B.svc | map(attribute=1) | join(', ')) ~ '.' ~ B.get('a_extra', '')) | tojson }},{{ ('Sie finden uns hier: ' ~ f.adresse ~ '. Telefon: ' ~ f.telefon ~ '.') | tojson }},{{ ('Sehr gern! Rufen Sie einfach an unter ' ~ f.telefon ~ ' oder nutzen Sie das Formular unten. Wir melden uns schnell zurück.') | tojson }}];{% endif %}
var T={leistungen:{{ B.get('tour_l', '') | tojson }},signatur:{{ B.get('tour_s', '') | tojson }},bewertungen:{{ B.get('tour_r', '') | tojson }},ueber:{{ B.get('tour_u', '') | tojson }},kontakt:{{ B.get('tour_k', '') | tojson }}};
var steps=['leistungen','signatur','bewertungen','ueber','kontakt'].filter(function(id){return T[id]&&document.getElementById(id)}),si=-1,hl=null,closed=false;
function go(el){var y=el.getBoundingClientRect().top+scrollY-70;if(window.__lenis)window.__lenis.scrollTo(y,{duration:1.6});else scrollTo({top:y,behavior:'smooth'})}
function show(h){say.innerHTML=h;say.classList.add('on');var x=say.querySelector('.rx');x&&(x.onclick=function(){say.classList.remove('on');closed=true;hl&&hl.classList.remove('tour-hl')})}
function hello(){if(closed)return;robo.classList.add('wave');show('<button class="rx" aria-label="Schließen">&times;</button><b>'+BN+' · '+{{ B.robot_tag | tojson }}+'</b>'+{{ B.robot_hello | tojson }}+'<div class="rb"><button type="button" id="rt1">Ja, gern</button><button type="button" class="ghost" id="rt2">Ich habe eine Frage</button></div>');document.getElementById('rt1').onclick=next;document.getElementById('rt2').onclick=chat}
function chat(){say.classList.remove('on');bot.classList.add('open')}
function next(){si++;hl&&hl.classList.remove('tour-hl');if(si>=steps.length){show('<button class="rx" aria-label="Schließen">&times;</button><b>'+BN+'</b>'+{{ B.get('robot_end', 'Das war die kleine Tour. Hast du noch eine Frage? Ich helfe dir gern.' if du else 'Das war die kleine Tour. Haben Sie noch eine Frage? Ich helfe Ihnen gern.') | tojson }}+'<div class="rb"><button type="button" id="rt3">Frage stellen</button><button type="button" class="ghost" id="rt4">Nochmal von vorn</button></div>');document.getElementById('rt3').onclick=chat;document.getElementById('rt4').onclick=function(){si=-1;next()};return}
 var id=steps[si],el=document.getElementById(id);hl=el;el.classList.add('tour-hl');go(el);
 show('<button class="rx" aria-label="Schließen">&times;</button><b>'+BN+' · Tour</b>'+T[id]+'<div class="rb"><button type="button" id="rtn">'+(si<steps.length-1?'Weiter':'Fertig')+'</button><span class="st">'+(si+1)+' / '+steps.length+'</span></div>');document.getElementById('rtn').onclick=next}
if(!QA){if(innerWidth<900){var hs=false,hm=function(){if(!hs&&scrollY>innerHeight*.6){hs=true;removeEventListener('scroll',hm);setTimeout(hello,600)}};addEventListener('scroll',hm,{passive:true});setTimeout(function(){if(!hs){hs=true;hello()}},14000)}else setTimeout(hello,3200)}
document.getElementById('botbtn').onclick=function(){if(say.classList.contains('on')){chat()}else{closed=false;si=-1;hello()}};
document.getElementById('botx').onclick=function(){bot.classList.remove('open')};
document.querySelectorAll('#chips button').forEach(function(b){b.onclick=function(){var u=document.createElement('div');u.className='m u';u.textContent=b.textContent;msgs.appendChild(u);setTimeout(function(){var m=document.createElement('div');m.className='m';m.textContent=A[b.dataset.a];msgs.appendChild(m);msgs.scrollTop=1e6},450)}});
})();
</script>
</body>
</html>
