{%- set c = f.v5.c -%}
{%- set V = f.v5 -%}
{%- macro img(k, cls="", alt="") -%}{% if k == 'glass' %}<div class="glassbg {{ cls }}" role="img" aria-label="{{ f.kurzname }}"></div>{% else %}<img src="{{ f.allimg[k] }}" alt="{{ alt or f.kurzname }}" class="{{ cls }}" style="object-position:{{ V.pos.get(k, '50% 50%') }}" loading="eager">{% endif %}{%- endmacro -%}
{%- macro hmedia(first) -%}{% set L = V.get('hero_slides') or [first] %}{% for k in L %}{% if k == 'glass' %}{{ img(k) }}{% else %}<img src="{{ f.allimg[k] }}" alt="{{ f.kurzname }}" class="sl{{ ' on' if loop.first }}" style="object-position:{{ V.pos.get(k, '50% 50%') }}" loading="eager">{% endif %}{% endfor %}{% if L|length > 1 %}<div class="dots" aria-hidden="true">{% for k in L %}<i{% if loop.first %} class="on"{% endif %}></i>{% endfor %}</div>{% endif %}{%- endmacro -%}
{%- macro stars() -%}<span class="stars" aria-hidden="true">{% for i in range(5) %}<svg viewBox="0 0 20 20"><path d="M10 1.6l2.6 5.5 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L1.4 7.9l6-.8z"/></svg>{% endfor %}</span>{%- endmacro -%}
{%- macro proof() -%}
<div class="proof">
  {%- if f.google %}<p class="g">{{ stars() }}<span><b>{{ f.google[0] }}</b> von 5 bei Google, {{ f.google[1] }} Bewertungen</span></p>{% endif %}
  {%- for s in f.siegel %}<p class="seal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.4 2.1 3.2-.3.8 3.1 2.8 1.6-1.2 3 1.2 3-2.8 1.6-.8 3.1-3.2-.3L12 22l-2.4-2.1-3.2.3-.8-3.1-2.8-1.6 1.2-3-1.2-3 2.8-1.6.8-3.1 3.2.3z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 12.2l2.3 2.2 4.7-4.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ s }}</p>{% endfor %}
</div>
{%- endmacro -%}
{%- macro htext(cls="") -%}
<div class="ht {{ cls }}">
  <p class="kicker">{{ f.tag | replace(' · ', ', ') }}</p>
  <h1>{{ f.h1 | safe }}</h1>
  <p class="sub">{{ f.sub }}</p>
  <div class="acts">
    <a class="btn" href="tel:{{ f.tel_link }}">Kostenlos beraten lassen</a>
    <a class="tel" href="tel:{{ f.tel_link }}">{{ icon_phone }}<span>{{ f.telefon }}</span></a>
  </div>
  {{ proof() }}
</div>
{%- endmacro -%}
{%- macro facts() -%}
<p class="facts">{% for a, b in f.trust %}<span><b>{{ a }}</b> {{ b }}.</span> {% endfor %}</p>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ f.kurzname }} – Entwurf</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?{{ V.fonts }}&display=swap" rel="stylesheet">
<style>
:root{--bg:{{ c.bg }};--ink:{{ c.ink }};--acc:{{ c.acc }};--acc2:{{ c.acc2 }};--soft:{{ c.soft }};--paper:{{ c.paper }};--hbg:{{ c.get('hbg', c.bg) }};--hink:{{ c.get('hink', c.ink) }};--fh:{{ V.fh | safe }};--fb:{{ V.fb | safe }};--hw:{{ V.get('hw', 700) }};--hls:{{ V.get('hls', '-0.02em') }};--htt:{{ V.get('htt', 'none') }};--hlh:{{ V.get('hlh', 0.95) }};--hst:{{ V.get('hst', '100%') }}}
*{box-sizing:border-box;margin:0;padding:0}
html,body{overflow-x:clip}
html.lenis,html.lenis body{height:auto}.lenis.lenis-smooth{scroll-behavior:auto!important}
body{background:var(--bg);color:var(--ink);font-family:var(--fb);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
img{display:block;width:100%;height:100%;object-fit:cover}
a{color:inherit}
h1,h2,h3{font-family:var(--fh);font-weight:var(--hw);letter-spacing:var(--hls);line-height:var(--hlh);text-transform:var(--htt);font-stretch:var(--hst)}
h1 span{display:block}
h2{font-size:clamp(2.2rem,5vw,4.4rem);margin-bottom:.5em;max-width:16ch}
.wrap{width:min(1240px,100% - 48px);margin:0 auto}
:focus-visible{outline:3px solid var(--acc2);outline-offset:3px}
/* Kopf */
.top{position:fixed;inset:0 0 auto;z-index:50;display:flex;align-items:center;gap:32px;padding:14px 32px;color:var(--hink);transition:background .3s,box-shadow .3s}
.top:not(.solid)::before{content:"";position:absolute;inset:0 0 -40px;z-index:-1;background:linear-gradient(to bottom,color-mix(in srgb,var(--hbg) 82%,transparent),transparent);pointer-events:none}
.top:not(.solid) nav a,.top:not(.solid) .ptel{text-shadow:0 1px 10px color-mix(in srgb,var(--hbg) 90%,transparent)}
.glassbg{position:absolute;inset:0;background:linear-gradient(160deg,#cfe3f3 0%,#7fb0d8 38%,#2c5f8e 62%,#9cc6e6 63%,#e4f0f8 100%);overflow:hidden}
.glassbg::before{content:"";position:absolute;inset:-20%;background:repeating-linear-gradient(115deg,rgba(255,255,255,.0) 0 90px,rgba(255,255,255,.28) 90px 120px,rgba(255,255,255,0) 120px 260px)}
.glassbg::after{content:"";position:absolute;inset:0;background:linear-gradient(to right,transparent calc(25% - 4px),#B9C2CA calc(25% - 4px) calc(25% + 4px),transparent 0,transparent calc(50% - 4px),#B9C2CA 0 calc(50% + 4px),transparent 0,transparent calc(75% - 4px),#B9C2CA 0 calc(75% + 4px),transparent 0),linear-gradient(to bottom,transparent calc(50% - 4px),#B9C2CA 0 calc(50% + 4px),transparent 0)}
.ab-img .glassbg,.cta-img .glassbg{position:absolute}
.top.solid{background:color-mix(in srgb,var(--hbg) 94%,transparent);backdrop-filter:blur(10px);box-shadow:0 1px 0 color-mix(in srgb,var(--hink) 12%,transparent)}
.top .logo{height:{{ V.get('logo_h', 42) }}px;width:auto;object-fit:contain{% if V.get('logo_bg') %};background:{{ V.logo_bg }};padding:6px 10px;border-radius:4px{% endif %}}
.top .wm{font-family:var(--fh);font-weight:var(--hw);font-size:22px;letter-spacing:var(--hls);text-decoration:none;text-transform:var(--htt)}
.top nav{margin-left:auto;display:flex;gap:28px;font-size:15px}
.top nav a{text-decoration:none;opacity:.8}.top nav a:hover{opacity:1}
.top .ptel{display:flex;align-items:center;gap:8px;font-weight:600;text-decoration:none;font-size:15px}
.top .ptel svg,.tel svg{width:18px;height:18px}
/* Hero Text */
.ht{position:relative;z-index:2}
.kicker{font-size:15px;opacity:.75;margin-bottom:18px}
.ht h1{font-size:clamp(2.8rem,{{ V.get('h1vw', 6.6) }}vw,{{ V.get('h1max', 7.2) }}rem);margin-bottom:24px}
.sub{font-size:clamp(1.05rem,1.35vw,1.25rem);max-width:44ch;opacity:.85}
.acts{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px;margin:30px 0 26px}
.btn{display:inline-block;background:var(--acc);color:{{ c.get('onacc', '#fff') }};padding:16px 28px;font-weight:600;text-decoration:none;border-radius:{{ V.get('r', '0') }};transition:transform .2s,background .2s}
.btn:hover{transform:translateY(-2px)}
.tel{display:flex;align-items:center;gap:10px;font-weight:600;text-decoration:none;font-size:18px}
.proof{display:flex;flex-wrap:wrap;gap:10px 26px;font-size:14.5px}
.proof p{display:flex;align-items:center;gap:8px}
.stars{display:flex;gap:2px}.stars svg{width:17px;height:17px;fill:{{ c.get('star', '#F5B301') }}}
.seal svg{width:22px;height:22px;color:var(--acc2)}
.facts{font-size:clamp(1.3rem,2.3vw,2.1rem);line-height:1.45;max-width:46ch}
.facts b{font-family:var(--fh);font-weight:var(--hw);font-size:1.5em;letter-spacing:var(--hls);color:var(--acc)}
/* ===== Hero: Maske ===== */
.h-mask{position:relative;height:{{ V.get('mask_h', 210) }}vh;background:var(--hbg);color:var(--hink)}
.hm-stick{position:sticky;top:0;height:100vh;overflow:hidden}
.hm-stick .ht{position:absolute;left:max(32px,4vw);bottom:15vh;width:min(46vw,640px)}
.hm-img{position:absolute;inset:0;will-change:clip-path}
.hm-in{position:absolute;inset:0;will-change:transform}
.sl{position:absolute;inset:0;opacity:0;transition:opacity 1.6s ease}
.sl.on{opacity:1;animation:kb 10s linear both}
@keyframes kb{from{transform:scale(1.02)}to{transform:scale(1.14)}}
.dots{position:absolute;right:5vw;bottom:5vh;z-index:4;display:flex;gap:8px}
.dots i{width:28px;height:3px;background:rgba(255,255,255,.5);transition:.4s}
.dots i.on{background:#fff;width:48px}
@keyframes glide{from{transform:translateX(-8%)}to{transform:translateX(8%)}}
.glassbg::before{animation:glide 9s ease-in-out infinite alternate}
.hm-cap{position:absolute;right:4vw;bottom:4vh;z-index:3;color:#fff;font-size:15px;opacity:0;background:color-mix(in srgb,var(--ink) 70%,transparent);padding:8px 14px}
@media (min-width:901px){
 .h-mask[data-shape=arch] .hm-img{clip-path:inset(15% 4% 0% 50% round 23vw 23vw 0 0)}
 .h-mask[data-shape=arch] .hm-in{transform:translateX(23%) scale(1.12)}
 .h-mask[data-shape=gable] .hm-img{clip-path:polygon(50% 34%, 72.5% 12%, 95% 34%, 95% 100%, 50% 100%)}
 .h-mask[data-shape=gable] .hm-in{transform:translateX(22.5%) scale(1.12)}
 .h-mask[data-shape=blob] .hm-img{clip-path:inset(13% 4% 9% 49% round 46% 54% 48% 52% / 56% 44% 56% 44%)}
 .h-mask[data-shape=blob] .hm-in{transform:translateX(22.5%) scale(1.12)}
 .h-mask[data-shape=diag] .hm-img{clip-path:polygon(62% 0%, 100% 0%, 100% 100%, 46% 100%)}
 .h-mask[data-shape=diag] .hm-in{transform:translateX(27%) scale(1.12)}
}
@media (min-width:901px) and (prefers-reduced-motion:reduce){.h-mask,.h-win{height:100vh}.pin-track{width:auto;overflow-x:auto}}
/* ===== Hero: Fenster / Scheiben ===== */
.h-panes{background:var(--hbg);color:var(--hink);padding-top:72px}
.hp-img{position:relative;height:{{ V.get('pane_h', 60) }}vh;overflow:hidden}
.hp-img .mull{position:absolute;background:{{ c.get('frame', '#A7B1BA') }};z-index:2;box-shadow:0 0 0 1px rgba(0,0,0,.08)}
.hp-band{padding:56px 0 64px}
.hp-band .wrap{display:grid;grid-template-columns:1.3fr 1fr;gap:56px;align-items:end}
.hp-band .ht h1{margin-bottom:0}
/* LS Fenster */
.h-win{position:relative;height:220vh;background:var(--hbg);color:var(--hink)}
.hw-stick{position:sticky;top:0;height:100vh;overflow:hidden;display:grid;grid-template-columns:1fr 1.05fr;align-items:center;gap:4vw;padding:80px 4vw 40px}
.win{position:relative;aspect-ratio:4/4.6;max-height:78vh;justify-self:center;width:100%;max-width:560px;border:{{ V.get('frame_w', 26) }}px solid {{ c.get('frame', '#383E42') }};box-shadow:inset 0 0 0 4px rgba(255,255,255,.06),0 30px 60px -20px rgba(0,0,0,.35);border-radius:3px;transform-origin:50% 50%;will-change:transform}
.win::before,.win::after{content:"";position:absolute;background:{{ c.get('frame', '#383E42') }};z-index:2}
.win::before{left:50%;top:0;bottom:0;width:{{ (V.get('frame_w', 26) * 0.7) | round | int }}px;transform:translateX(-50%)}
.win::after{top:46%;left:0;right:0;height:{{ (V.get('frame_w', 26) * 0.7) | round | int }}px}
.win .glass{position:absolute;inset:0;overflow:hidden}
.win .glare{position:absolute;inset:0;z-index:3;background:linear-gradient(115deg,rgba(255,255,255,.22) 0 18%,transparent 18% 40%,rgba(255,255,255,.1) 40% 46%,transparent 46%);pointer-events:none}
/* ===== Hero: Zahl ===== */
.h-num{background:var(--hbg);color:var(--hink);padding:120px 0 0;overflow:hidden}
.hn-top{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:end}
.hn-top .ht h1{font-size:clamp(2.4rem,4.6vw,4.6rem);margin:0}
.hn-num{font-family:var(--fh);font-weight:900;font-size:min(36vw,560px);line-height:.78;letter-spacing:-.06em;text-align:center;margin:3vw 0 0;color:transparent;background-image:url("{{ f.allimg[V.num_img] }}");background-size:{{ V.get('num_bgsize', 'cover') }};background-position:30% 50%;-webkit-background-clip:text;background-clip:text;will-change:background-position}
.hn-strip{height:56vh;position:relative}
/* ===== Hero: Portrait ===== */
.h-por{background:var(--hbg);color:var(--hink);min-height:100vh;display:grid;grid-template-columns:1.25fr 1fr;padding-top:72px}
.hpo-t{display:flex;flex-direction:column;justify-content:center;padding:6vh 4vw 6vh max(32px,5vw)}
.hpo-t .ht h1{font-size:clamp(3.4rem,9.4vw,10.5rem)}
.hpo-p{position:relative;overflow:hidden}
.hpo-p figcaption{position:absolute;left:0;bottom:0;background:var(--acc);color:{{ c.get('onacc', '#fff') }};padding:16px 22px;font-size:15px;line-height:1.35}
.hpo-p figcaption b{display:block;font-family:var(--fh);font-size:22px;font-weight:var(--hw);letter-spacing:var(--hls)}
/* ===== Hero: Collage ===== */
.h-col{background:var(--hbg);color:var(--hink);min-height:100vh;padding:120px 0 80px;overflow:hidden}
.h-col .wrap{display:grid;grid-template-columns:1fr 1.05fr;gap:40px;align-items:center}
.prints{position:relative;height:min(74vh,680px)}
.print{position:absolute;background:#fff;padding:12px 12px 44px;box-shadow:0 22px 44px -18px rgba(0,0,0,.4);will-change:transform}
.print figcaption{position:absolute;left:14px;bottom:12px;font-size:14px;color:#333;font-family:var(--fh)}
.print:nth-child(1){width:58%;height:60%;left:0;top:4%;transform:rotate(-5deg)}
.print:nth-child(2){width:56%;height:58%;right:0;top:0;transform:rotate(4deg)}
.print:nth-child(3){width:60%;height:56%;left:20%;bottom:0;transform:rotate(-1.5deg)}
/* ===== Hero: Leitung ===== */
.h-cir{background:var(--hbg);color:var(--hink);padding:130px 0 0;position:relative;overflow:hidden}
.hc-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
.hc-img{position:relative;margin-top:60px;height:62vh}
.hc-img::before{content:"";position:absolute;inset:-18px 18px 18px -18px;border:2px solid var(--acc2);z-index:0}
.hc-img .sl{z-index:1}.hc-img .sl.on{animation:none}
.cable{position:absolute;inset:0;pointer-events:none;z-index:1}
.cable path{fill:none;stroke:var(--acc2);stroke-width:2.5}
.wire{position:fixed;left:18px;top:0;bottom:0;width:3px;z-index:40;background:color-mix(in srgb,var(--acc2) 18%,transparent)}
.wire i{position:absolute;inset:0;background:var(--acc2);transform-origin:top;transform:scaleY(0)}
/* ===== Leistungen ===== */
.sec{padding:clamp(80px,11vw,150px) 0}
.svc-head{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:48px}
.svc-head p{max-width:40ch;opacity:.8}
/* index */
.idx-wrap{display:grid;grid-template-columns:1fr minmax(0,.85fr);gap:5vw;align-items:start}
.idx-media{position:sticky;top:96px;height:min(74vh,700px);overflow:hidden}
.idx-media img{position:absolute;inset:0;opacity:0;transform:scale(1.06);transition:opacity .5s,transform .9s}
.idx-media img.on{opacity:1;transform:none}
.idx{list-style:none;position:relative}
.idx li.on .n{color:var(--acc);transform:translateX(14px)}
.idx li{display:grid;grid-template-columns:1fr auto;align-items:center;gap:24px;padding:14px 0;cursor:default}
.idx li .n{font-family:var(--fh);font-weight:var(--hw);letter-spacing:var(--hls);font-size:clamp(1.9rem,4.4vw,4rem);line-height:1.05;transition:color .25s,transform .35s;text-transform:var(--htt)}
.idx li .th{display:none;width:84px;height:62px;overflow:hidden}
.idx li:hover .n{color:var(--acc);transform:translateX(14px)}
.idx.noimg{columns:2;column-gap:64px}
.idx.noimg li{break-inside:avoid;grid-template-columns:auto 1fr;gap:18px;padding:12px 0}
.idx.noimg li svg{width:34px;height:34px;color:var(--acc)}
.idx.noimg li .n{font-size:clamp(1.5rem,2.6vw,2.3rem)}
/* pin */
.pin{overflow:hidden}
.pin-track{display:flex;gap:28px;padding:0 4vw;width:max-content}
.pin-it{width:min(58vw,760px);flex:none}
.pin-it .ph{height:62vh;overflow:hidden}
.pin-it h3{font-size:clamp(1.6rem,2.8vw,2.6rem);margin-top:18px}
.pin-intro{flex:none;width:min(34vw,440px);display:flex;flex-direction:column;justify-content:center}
.pin-intro h2{font-size:clamp(2.4rem,4.4vw,4.4rem)}
/* stack */
.stk{position:relative}
.stk-it{position:sticky;top:72px;height:calc(100vh - 110px);margin-bottom:24px;overflow:hidden}
.stk-it .lbl{position:absolute;left:0;bottom:0;background:var(--paper);color:var(--ink);padding:22px 30px 20px;max-width:min(92%,640px)}
.stk-it .lbl h3{font-size:clamp(1.8rem,3.6vw,3.4rem)}
.more{display:flex;flex-wrap:wrap;gap:12px 40px;margin-top:40px;font-family:var(--fh);font-size:clamp(1.3rem,2.2vw,1.9rem);font-weight:var(--hw);letter-spacing:var(--hls)}
/* Über uns */
.ab{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(40px,6vw,96px);align-items:center}
.ab.flip .ab-img{order:2}
.ab-img{position:relative;height:min(84vh,760px)}
.ab-img .small{position:absolute;width:42%;height:38%;right:-6%;bottom:-8%;border:10px solid var(--bg)}
.ab-img figcaption{position:absolute;left:0;top:100%;margin-top:12px;font-size:14.5px;opacity:.75}
.ab-t p{margin-bottom:1em;max-width:52ch}
.checks{list-style:none;margin-top:28px}
.checks li{display:flex;gap:14px;align-items:flex-start;padding:7px 0;font-weight:500}
.checks svg{flex:none;width:22px;height:22px;margin-top:3px;color:var(--acc)}
.ab-t .facts{margin-top:30px}
/* Ablauf */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(20px,3vw,44px);counter-reset:s}
.steps li{list-style:none;position:relative;padding-top:24px}
.steps li::before{counter-increment:s;content:counter(s);display:block;font-family:var(--fh);font-weight:var(--hw);font-size:clamp(3rem,5vw,4.6rem);line-height:1;color:var(--acc);margin-bottom:16px;letter-spacing:var(--hls)}
.steps h3{font-size:1.35rem;margin-bottom:8px;letter-spacing:0;line-height:1.2;text-transform:none}
.steps p{opacity:.8;font-size:16px}
.tone{background:var(--soft)}
.dark{background:var(--ink);color:var(--paper)}
/* Galerie */
.rail-wrap{position:relative}
.rail{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 4vw 8px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.rail::-webkit-scrollbar{display:none}
.rail figure{flex:none;scroll-snap-align:start;height:min(70vh,620px);overflow:hidden}
.rail figure:nth-child(3n+1){width:min(70vw,860px)}
.rail figure:nth-child(3n+2){width:min(44vw,520px)}
.rail figure:nth-child(3n){width:min(56vw,680px)}
.rail-nav{display:flex;gap:10px;justify-content:flex-end;margin-top:22px}
.rail-nav button{width:52px;height:52px;border:1.5px solid currentColor;background:none;color:inherit;cursor:pointer;display:grid;place-items:center;border-radius:{{ V.get('r', '0') }}}
.rail-nav button svg{width:20px;height:20px}
.rail-nav button:hover{background:var(--acc);border-color:var(--acc);color:#fff}
/* Kontakt */
.cta{display:grid;grid-template-columns:1.1fr 1fr;min-height:80vh;background:var(--acc);color:{{ c.get('onacc', '#fff') }}}
.cta-t{padding:clamp(56px,8vw,120px) max(32px,5vw);display:flex;flex-direction:column;justify-content:center}
.cta-t h2{max-width:13ch}
.cta-t p{max-width:46ch;opacity:.9;margin-bottom:34px}
.cta-t .big{font-family:var(--fh);font-weight:var(--hw);font-size:clamp(2.2rem,5vw,4.6rem);letter-spacing:var(--hls);text-decoration:none;line-height:1}
.cta-t .mail{margin-top:18px;opacity:.85}
.cta-t .btn{background:{{ c.get('ctabtn', c.ink) }};color:{{ c.get('onctabtn', '#fff') }};margin-top:34px;align-self:flex-start}
.cta-img{position:relative;overflow:hidden;min-height:50vh}
/* Fuß */
footer{background:var(--ink);color:var(--paper);padding:64px 0 120px;font-size:15px}
footer .wrap{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}
footer h4{font-family:var(--fh);font-size:24px;font-weight:var(--hw);letter-spacing:var(--hls);margin-bottom:10px;text-transform:var(--htt)}
footer a{text-decoration:none;opacity:.85}
footer .note{grid-column:1/-1;margin-top:28px;padding-top:22px;border-top:1px solid color-mix(in srgb,var(--paper) 18%,transparent);opacity:.6;font-size:13.5px}
/* Entwurfshinweis */
.pv{position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgba(18,18,20,.92);backdrop-filter:blur(8px);color:#fff;padding:9px 48px 9px 20px;font-size:13px;line-height:1.4;text-align:center}
.pv b{margin-right:8px}
.pv button{position:absolute;right:12px;top:50%;margin-top:-13px;width:26px;height:26px;border:0;background:none;cursor:pointer;font-size:0}
.pv button::before,.pv button::after{content:"";position:absolute;left:6px;top:12px;width:14px;height:2px;background:#ddd;transform:rotate(45deg)}
.pv button::after{transform:rotate(-45deg)}
.callbar{display:none}
.hp-img .glassbg::after{display:none}
/* Glas-Badge im Über-uns-Bild */
.ab-badge{position:absolute;left:-28px;top:32px;z-index:3;padding:16px 20px;background:color-mix(in srgb,var(--paper) 72%,transparent);backdrop-filter:blur(14px) saturate(1.3);-webkit-backdrop-filter:blur(14px) saturate(1.3);color:var(--ink);box-shadow:0 18px 40px -18px rgba(0,0,0,.45);border-radius:{{ V.get('r2', '14px') }};max-width:250px;font-size:14px;line-height:1.35}
.ab-badge b{display:block;font-family:var(--fh);font-weight:var(--hw);font-size:30px;letter-spacing:var(--hls);line-height:1}
/* Anfrage */
.lead{margin-top:34px;display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:520px;background:color-mix(in srgb,#000 14%,transparent);padding:18px;border-radius:{{ V.get('r2', '14px') }};backdrop-filter:blur(6px)}
.lead input,.lead select{width:100%;padding:13px 14px;border:0;font:inherit;font-size:15px;background:rgba(255,255,255,.94);color:#111;border-radius:{{ V.get('r', '0') }}}
.lead select,.lead button,.lead small{grid-column:1/-1}
.lead button{padding:15px;border:0;font:inherit;font-weight:600;cursor:pointer;background:{{ c.get('ctabtn', c.ink) }};color:{{ c.get('onctabtn', '#fff') }};border-radius:{{ V.get('r', '0') }}}
.lead small{font-size:12.5px;opacity:.85}
/* Assistent */
.bot-btn{position:fixed;right:20px;bottom:54px;z-index:58;display:flex;align-items:center;gap:10px;padding:12px 18px 12px 12px;border:0;cursor:pointer;background:var(--ink);color:var(--paper);font:inherit;font-weight:600;font-size:14.5px;border-radius:40px;box-shadow:0 14px 30px -10px rgba(0,0,0,.5)}
.bot-btn i{width:34px;height:34px;border-radius:50%;background:var(--acc);display:grid;place-items:center;color:{{ c.get('onacc', '#fff') }}}
.bot-btn svg{width:18px;height:18px}
.bot{position:fixed;right:20px;bottom:116px;z-index:59;width:min(360px,calc(100vw - 24px));max-height:70vh;display:none;flex-direction:column;background:color-mix(in srgb,var(--paper) 86%,transparent);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);color:var(--ink);border-radius:18px;box-shadow:0 30px 60px -20px rgba(0,0,0,.5);overflow:hidden}
.bot.open{display:flex}
.bot header{display:flex;align-items:center;gap:10px;padding:14px 16px;background:var(--ink);color:var(--paper);font-weight:600;font-size:15px}
.bot header small{display:block;font-weight:400;opacity:.7;font-size:12px}
.bot header button{margin-left:auto;background:none;border:0;color:inherit;font-size:22px;cursor:pointer;line-height:1}
.bot .msgs{padding:14px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;font-size:14.5px;line-height:1.45}
.bot .m{max-width:86%;padding:10px 13px;border-radius:14px;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.bot .m.u{align-self:flex-end;background:var(--acc);color:{{ c.get('onacc', '#fff') }}}
.bot .chips{display:flex;flex-wrap:wrap;gap:6px;padding:0 14px 14px}
.bot .chips button{border:1.5px solid var(--acc);background:transparent;color:var(--ink);padding:7px 11px;border-radius:20px;font:inherit;font-size:13px;cursor:pointer}
.bot .demo{font-size:11.5px;opacity:.6;padding:0 14px 12px}
/* Aktions-Hinweis */
.promo{position:fixed;right:20px;bottom:116px;z-index:57;width:min(330px,calc(100vw - 24px));display:grid;grid-template-columns:96px 1fr;background:var(--paper);color:var(--ink);box-shadow:0 24px 50px -18px rgba(0,0,0,.5);border-radius:{{ V.get('r2', '14px') }};overflow:hidden;transform:translateY(30px);opacity:0;pointer-events:none;transition:.5s cubic-bezier(.2,.8,.2,1)}
.promo.show{transform:none;opacity:1;pointer-events:auto}
.promo .pi{position:relative;min-height:120px}
.promo div.pt{padding:14px 34px 14px 14px;font-size:14px;line-height:1.4}
.promo b{display:block;font-family:var(--fh);font-weight:var(--hw);font-size:18px;letter-spacing:var(--hls);margin:2px 0 8px;line-height:1.1}
.promo a{font-weight:600;color:var(--acc)}
.promo small{font-size:11.5px;opacity:.6}
.promo .x{position:absolute;right:6px;top:6px;border:0;background:none;font-size:20px;cursor:pointer;color:inherit}
/* ===== Mobil ===== */
@media (max-width:900px){
  body{font-size:16px}
  .top{padding:12px 18px;gap:12px}
  .top nav{display:none}
  .top .ptel{margin-left:auto}.top .ptel span{display:none}
  .top .ptel{width:44px;height:44px;justify-content:center;background:var(--acc);color:{{ c.get('onacc', '#fff') }};border-radius:{{ V.get('r', '0') }}}
  .top .logo{height:{{ (V.get('logo_h', 42) * 0.8) | round | int }}px;max-width:58vw}
  .wrap{width:calc(100% - 36px)}
  .h-mask{height:auto}
  .hm-stick{position:relative;height:auto;display:flex;flex-direction:column;overflow:visible;padding-top:96px}
  .hm-stick .ht{position:relative;left:auto;bottom:auto;width:auto;padding:0 18px 32px;order:1}
  .hm-img{position:relative;order:2;height:64vh;margin:0 0 0;clip-path:var(--mclip)!important}
  .hm-in{transform:none!important}
  .hm-cap{display:none}
  .hp-band .wrap,.hn-top,.hc-grid,.h-col .wrap,.ab,.cta,footer .wrap{grid-template-columns:1fr}
  .hp-img{height:46vh}
  .hp-band{padding:34px 0 44px}
  .h-win{height:auto}
  .hw-stick{position:relative;height:auto;grid-template-columns:1fr;padding:96px 18px 48px;gap:36px}
  .win{max-width:84vw;transform:none!important}
  .h-num{padding-top:100px}
  .hn-num{font-size:40vw;margin-top:28px}
  .hn-strip{height:40vh}
  .h-por{grid-template-columns:1fr;min-height:0}
  .hpo-t{padding:36px 18px 40px;order:1}
  .hpo-p{order:2;height:78vh}
  .h-col{padding:100px 0 56px}
  .prints{height:94vw;margin-top:12px}
  .h-cir{padding-top:100px}
  .hc-img{height:44vh;margin:20px 0 0 18px}
  .wire{left:6px;width:2px}
  .svc-head{flex-direction:column;align-items:flex-start;gap:8px}
  .idx-wrap{grid-template-columns:1fr}.idx-media{display:none}
  .idx li .th{display:block}
  .idx li.on .n{transform:none}
  .idx li:hover .n{transform:none}
  .idx.noimg{columns:1}
  .pin-track{width:auto;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 18px;transform:none!important;scrollbar-width:none}
  .pin-track::-webkit-scrollbar{display:none}
  .pin-it{width:82vw;scroll-snap-align:start}
  .pin-it .ph{height:56vh}
  .pin-intro{display:none}
  .svc-mob{display:block!important;margin-bottom:28px}
  .stk-it{height:70vh;top:64px}
  .ab.flip .ab-img{order:0}
  .ab-img{height:62vh}
  .ab-img .small{right:-2%}
  .steps{grid-template-columns:1fr 1fr;gap:30px 22px}
  .rail figure{height:52vh}
  .rail figure:nth-child(n){width:80vw}
  .cta{min-height:0}
  .cta-img{order:-1;height:46vh;min-height:0}
  .pv{bottom:56px;padding:8px 44px 8px 14px;font-size:12px;text-align:left}
  .bot-btn{bottom:112px;right:12px;padding:8px;}.bot-btn span{display:none}.bot,.promo{bottom:166px;right:12px}
  .ab-badge{left:12px;top:12px}
  .lead{grid-template-columns:1fr}
  .callbar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:55;background:var(--ink)}
  .callbar a{flex:1;display:flex;align-items:center;justify-content:center;gap:10px;padding:17px 10px;color:var(--paper);text-decoration:none;font-weight:600;font-size:15px}
  .callbar a+a{background:var(--acc);color:{{ c.get('onacc', '#fff') }}}
  .callbar svg{width:18px;height:18px}
  footer{padding-bottom:150px}
}
@media (max-width:520px){.steps{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body data-hero="{{ V.hero }}">
<header class="top" id="top">
  {% if f.logo and V.get('logo', True) %}<a href="#"><img class="logo" src="{{ f.logo }}" alt="{{ f.kurzname }}"></a>{% else %}<a class="wm" href="#">{{ V.get('wordmark', f.kurzname) }}</a>{% endif %}
  <nav><a href="#leistungen">Leistungen</a><a href="#ueber">Über uns</a><a href="#kontakt">Kontakt</a></nav>
  <a class="ptel" href="tel:{{ f.tel_link }}">{{ icon_phone }}<span>{{ f.telefon }}</span></a>
</header>
{% if V.hero == 'circuit' %}<div class="wire" aria-hidden="true"><i></i></div>{% endif %}

{# ================= HERO ================= #}
{% if V.hero == 'mask' %}
<section class="h-mask" data-shape="{{ V.shape }}" style="--mclip:{{ V.mclip | safe }}">
  <div class="hm-stick">
    {{ htext() }}
    <div class="hm-img"><div class="hm-in">{{ hmedia(V.hero_img) }}</div></div>
  </div>
</section>
{% elif V.hero == 'panes' %}
<section class="h-panes">
  <div class="hp-img" data-cols="{{ V.get('cols', 4) }}" data-rows="{{ V.get('rows', 2) }}">{{ hmedia(V.hero_img) }}</div>
  <div class="hp-band"><div class="wrap">
    <div class="ht"><p class="kicker">{{ f.tag | replace(' · ', ', ') }}</p><h1>{{ f.h1 | safe }}</h1></div>
    <div><p class="sub">{{ f.sub }}</p><div class="acts"><a class="btn" href="tel:{{ f.tel_link }}">Kostenlos beraten lassen</a><a class="tel" href="tel:{{ f.tel_link }}">{{ icon_phone }}<span>{{ f.telefon }}</span></a></div>{{ proof() }}</div>
  </div></div>
</section>
{% elif V.hero == 'window' %}
<section class="h-win">
  <div class="hw-stick">
    {{ htext() }}
    <div class="win"><div class="glass">{{ hmedia(V.hero_img) }}</div><div class="glare"></div></div>
  </div>
</section>
{% elif V.hero == 'numerals' %}
<section class="h-num">
  <div class="wrap hn-top">
    <div class="ht"><p class="kicker">{{ f.tag | replace(' · ', ', ') }}</p><h1>{{ f.h1 | safe }}</h1></div>
    <div><p class="sub">{{ f.sub }}</p><div class="acts"><a class="btn" href="tel:{{ f.tel_link }}">Kostenlos beraten lassen</a><a class="tel" href="tel:{{ f.tel_link }}">{{ icon_phone }}<span>{{ f.telefon }}</span></a></div>{{ proof() }}</div>
  </div>
  <p class="hn-num" aria-hidden="true">{{ V.num }}</p>
</section>
{% elif V.hero == 'portrait' %}
<section class="h-por">
  <div class="hpo-t">{{ htext() }}</div>
  <figure class="hpo-p">{{ img(f.inhaber_k, 'eager', f.inhaber_name) }}<figcaption><b>{{ f.inhaber_name }}</b>{{ f.inhaber_rolle | replace(' · ', ' und ') }}</figcaption></figure>
</section>
{% elif V.hero == 'collage' %}
<section class="h-col">
  <div class="wrap">
    {{ htext() }}
    <div class="prints">{% for k, cap in V.prints %}<figure class="print">{{ img(k, 'eager') }}<figcaption>{{ cap }}</figcaption></figure>{% endfor %}</div>
  </div>
</section>
{% elif V.hero == 'circuit' %}
<section class="h-cir">
  <svg class="cable" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true"><path d="M-10 640 C 260 640, 300 380, 560 380 S 760 160, 1000 160 L 1460 160"/></svg>
  <div class="wrap hc-grid">
    {{ htext() }}
    <div class="hc-img">{{ hmedia(V.hero_img) }}</div>
  </div>
</section>
{% endif %}

{# ================= SECTIONS ================= #}
{% for s in V.order %}
{% if s == 'facts' %}
<section class="sec {{ V.get('facts_cls', '') }}" style="padding-block:clamp(56px,7vw,96px)"><div class="wrap">{{ facts() }}</div></section>

{% elif s == 'svc' %}
{% set svc_imgs = V.svc_imgs %}
{% if V.svc == 'index' %}
<section class="sec {{ V.get('svc_cls', '') }}" id="leistungen"><div class="wrap">
  <div class="svc-head"><h2>{{ f.leist_h2 }}</h2><p>Sprechen Sie uns zu jedem dieser Bereiche an. Wir beraten Sie kostenlos und ehrlich.</p></div>
  {% if svc_imgs %}
  <div class="idx-wrap"><ul class="idx">{% for l in f.leistungen %}<li data-i="{{ loop.index0 }}"{% if loop.first %} class="on"{% endif %}><span class="n">{{ l }}</span><span class="th">{{ img(svc_imgs[loop.index0 % svc_imgs|length]) }}</span></li>{% endfor %}</ul>
  <div class="idx-media" aria-hidden="true">{% for l in f.leistungen %}{{ img(svc_imgs[loop.index0 % svc_imgs|length], 'on' if loop.first else '') }}{% endfor %}</div></div>
  {% else %}
  <ul class="idx noimg">{% for l in f.leistungen %}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ V.icons[loop.index0 % V.icons|length] | safe }}</svg><span class="n">{{ l }}</span></li>{% endfor %}</ul>
  {% endif %}
</div></section>
{% elif V.svc == 'pin' %}
<section class="sec pin {{ V.get('svc_cls', '') }}" id="leistungen">
  <div class="wrap svc-mob" style="display:none"><h2>{{ f.leist_h2 }}</h2></div>
  <div class="pin-track">
    <div class="pin-intro"><h2>{{ f.leist_h2 }}</h2><p style="opacity:.8;max-width:34ch">Ein Ausschnitt aus unserer Arbeit. Ziehen Sie weiter, um mehr zu sehen.</p></div>
    {% for l in f.leistungen[:svc_imgs|length] %}<article class="pin-it"><div class="ph">{{ img(svc_imgs[loop.index0]) }}</div><h3>{{ l }}</h3></article>{% endfor %}
  </div>
  {% if f.leistungen|length > svc_imgs|length %}<div class="wrap"><p class="more">{% for l in f.leistungen[svc_imgs|length:] %}<span>{{ l }}</span>{% endfor %}</p></div>{% endif %}
</section>
{% elif V.svc == 'stack' %}
<section class="sec {{ V.get('svc_cls', '') }}" id="leistungen"><div class="wrap">
  <div class="svc-head"><h2>{{ f.leist_h2 }}</h2></div>
  <div class="stk">{% for l in f.leistungen[:svc_imgs|length] %}<article class="stk-it">{{ img(svc_imgs[loop.index0]) }}<div class="lbl"><h3>{{ l }}</h3></div></article>{% endfor %}</div>
  {% if f.leistungen|length > svc_imgs|length %}<p class="more">{% for l in f.leistungen[svc_imgs|length:] %}<span>{{ l }}</span>{% endfor %}</p>{% endif %}
</div></section>
{% endif %}

{% elif s == 'about' %}
<section class="sec {{ V.get('about_cls', '') }}" id="ueber"><div class="wrap ab {{ 'flip' if V.get('about_flip') }}">
  <figure class="ab-img">
    {% if f.inhaber_k and V.hero != 'portrait' and V.get('about_owner', True) %}{{ img(f.inhaber_k, '', f.inhaber_name) }}<figcaption>{{ f.inhaber_name }}, {{ f.inhaber_rolle | replace(' · ', ', ') }}</figcaption>
    {% else %}{{ img(V.about_img) }}{% if V.get('about_img2') %}<div class="small">{{ img(V.about_img2) }}</div>{% endif %}{% endif %}
    {% if f.google %}<div class="ab-badge"><b>{{ f.google[0] }}</b>{{ stars() }}{{ f.google[1] }} Bewertungen bei Google</div>{% elif f.trust %}<div class="ab-badge"><b>{{ f.trust[0][0] }}</b>{{ f.trust[0][1] }}</div>{% endif %}
  </figure>
  <div class="ab-t">
    <h2>{{ f.about_h2 }}</h2>
    {% for p in f.ueber %}<p>{{ p }}</p>{% endfor %}
    <ul class="checks">{% for ch in f.checks %}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{{ ch }}</li>{% endfor %}</ul>
    {% if 'facts' not in V.order %}{{ facts() }}{% endif %}
  </div>
</div></section>

{% elif s == 'steps' %}
<section class="sec {{ V.get('steps_cls', 'tone') }}"><div class="wrap">
  <h2>So arbeiten wir mit Ihnen.</h2>
  <ol class="steps">{% for a, b in steps %}<li><h3>{{ a }}</h3><p>{{ b }}</p></li>{% endfor %}</ol>
</div></section>

{% elif s == 'gal' %}
<section class="sec {{ V.get('gal_cls', '') }}"><div class="wrap"><h2>{{ f.get('gal_h2') or 'Aus unserer Arbeit.' }}</h2></div>
  <div class="rail-wrap"><div class="rail" id="rail">{% for k in V.gal %}<figure>{{ img(k) }}</figure>{% endfor %}</div>
  <div class="wrap rail-nav"><button type="button" aria-label="Zurück" data-d="-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"/></svg></button><button type="button" aria-label="Weiter" data-d="1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg></button></div></div>
</section>

{% elif s == 'strip' %}
<div class="hn-strip">{{ img(V.strip_img) }}</div>

{% elif s == 'cta' %}
<section class="cta" id="kontakt">
  <div class="cta-t">
    <h2>Lassen Sie sich kostenlos beraten.</h2>
    <p>Rufen Sie uns an. Wir besprechen Ihr Vorhaben unverbindlich und sagen Ihnen ehrlich, was möglich ist.</p>
    <a class="big" href="tel:{{ f.tel_link }}">{{ f.telefon }}</a>
    {% if f.email %}<a class="mail" href="mailto:{{ f.email }}">{{ f.email }}</a>{% endif %}
    <form class="lead" onsubmit="event.preventDefault();this.querySelector('small').textContent='Danke! Im fertigen System landet Ihre Anfrage sofort im CRM und Sie bekommen eine Bestätigung. Im Entwurf ist das Formular noch nicht aktiv.'">
      <input aria-label="Ihr Name" placeholder="Ihr Name"><input aria-label="Telefon" placeholder="Telefon" inputmode="tel">
      <select aria-label="Anliegen"><option>Worum geht es?</option>{% for l in f.leistungen %}<option>{{ l }}</option>{% endfor %}</select>
      <button type="submit">Rückruf anfordern</button>
      <small>Beispiel-Funktion: Anfragen landen direkt im CRM, mit automatischer Bestätigung.</small>
    </form>
  </div>
  <div class="cta-img">{{ img(V.cta_img) }}</div>
</section>
{% endif %}
{% endfor %}

<footer><div class="wrap">
  <div><h4>{{ f.kurzname }}</h4><p>{{ f.firma }}<br>{{ f.adresse }}</p></div>
  <div><p><a href="tel:{{ f.tel_link }}">{{ f.telefon }}</a><br>{% if f.email %}<a href="mailto:{{ f.email }}">{{ f.email }}</a>{% endif %}</p></div>
  <div><p><a href="#">Impressum</a><br><a href="#">Datenschutz</a></p></div>
  <p class="note">Grober Entwurf von High Level Performance mit Bildern und Texten von {{ f.website_kurz }}. Bei einer Zusammenarbeit wird alles viel intensiver ausgearbeitet.</p>
</div></footer>

<aside class="pv" id="pv"><b>Grober Entwurf</b>Erstellt von High Level Performance. Bei einer Zusammenarbeit arbeiten wir jede Seite viel intensiver aus.<button type="button" aria-label="Hinweis schließen" onclick="this.parentNode.remove()">x</button></aside>
<button class="bot-btn" type="button" id="botbtn"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg></i><span>Fragen? Assistent</span></button>
<div class="bot" id="bot" role="dialog" aria-label="Assistent">
  <header><div>{{ f.kurzname }}<small>Digitaler Assistent, rund um die Uhr</small></div><button type="button" aria-label="Schließen" id="botx">&times;</button></header>
  <div class="msgs" id="msgs"><div class="m">Guten Tag! Ich bin der digitale Assistent von {{ f.kurzname }}. Wobei kann ich helfen?</div></div>
  <div class="chips" id="chips"><button type="button" data-a="0">Welche Leistungen bieten Sie an?</button><button type="button" data-a="1">Wo finde ich Sie?</button><button type="button" data-a="2">Kostenlose Beratung</button></div>
  <p class="demo">Beispiel-Funktion im Entwurf. Im fertigen System beantwortet der KI-Assistent Fragen mit Ihren eigenen Infos und trägt Anfragen ins CRM ein.</p>
</div>
<aside class="promo" id="promo"><div class="pi">{{ img(V.get('promo_img') or (V.svc_imgs[0] if V.svc_imgs else V.hero_img)) }}</div><div class="pt"><small>Beispiel: Aktions-Hinweis</small><b>{{ V.get('promo', f.leistungen[0]) }}</b>Jetzt gefragt. Lassen Sie sich kostenlos beraten.<br><a href="tel:{{ f.tel_link }}">{{ f.telefon }}</a></div><button class="x" type="button" aria-label="Schließen" onclick="this.parentNode.remove()">&times;</button></aside>
<div class="callbar"><a href="tel:{{ f.tel_link }}">{{ icon_phone }}Anrufen</a><a href="tel:{{ f.tel_link }}">Kostenlose Beratung</a></div>

<script src="../../assets/vendor/gsap.min.js"></script>
<script src="../../assets/vendor/ScrollTrigger.min.js"></script>
<script src="../../assets/vendor/lenis.min.js"></script>
<script>
(function(){
var top=document.getElementById('top');
function hd(){top.classList.toggle('solid',scrollY>40)}hd();addEventListener('scroll',hd,{passive:true});
var rail=document.getElementById('rail');
document.querySelectorAll('.rail-nav button').forEach(function(b){b.onclick=function(){rail.scrollBy({left:rail.clientWidth*.6*b.dataset.d,behavior:'smooth'})}});
var lis=document.querySelectorAll('.idx li'),mi=document.querySelectorAll('.idx-media img');
function act(i){lis.forEach(function(l,k){l.classList.toggle('on',k==i)});mi.forEach(function(m,k){m.classList.toggle('on',k==i)})}
lis.forEach(function(l){l.addEventListener('mouseenter',function(){act(+l.dataset.i)})});
if('IntersectionObserver' in window&&mi.length){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)act(+e.target.dataset.i)})},{rootMargin:'-45% 0px -45% 0px'});lis.forEach(function(l){io.observe(l)})}
var A=[{{ ('Wir bieten unter anderem: ' ~ (f.leistungen | join(', ')) ~ '.') | tojson }},{{ ('Sie finden uns hier: ' ~ f.adresse ~ '. Telefon: ' ~ f.telefon ~ '.') | tojson }},{{ ('Sehr gern! Rufen Sie einfach an unter ' ~ f.telefon ~ ' oder nutzen Sie das Formular unten. Die Beratung ist kostenlos und unverbindlich.') | tojson }}];
var bot=document.getElementById('bot'),msgs=document.getElementById('msgs'),pr=document.getElementById('promo');
document.getElementById('botbtn').onclick=function(){bot.classList.toggle('open');pr&&pr.classList.remove('show')};
document.getElementById('botx').onclick=function(){bot.classList.remove('open')};
document.querySelectorAll('#chips button').forEach(function(b){b.onclick=function(){var u=document.createElement('div');u.className='m u';u.textContent=b.textContent;msgs.appendChild(u);setTimeout(function(){var m=document.createElement('div');m.className='m';m.textContent=A[b.dataset.a];msgs.appendChild(m);msgs.scrollTop=1e6},450)}});
var shown=false;function sp(){if(shown||!pr||bot.classList.contains('open'))return;if(scrollY>innerHeight*1.4){shown=true;pr.classList.add('show')}}addEventListener('scroll',sp,{passive:true});
document.querySelectorAll('.hm-in,.glass,.hc-img,.hp-img').forEach(function(w){var sl=w.querySelectorAll('.sl'),dt=w.querySelectorAll('.dots i');if(sl.length<2)return;var k=0;setInterval(function(){sl[k].classList.remove('on');dt[k]&&dt[k].classList.remove('on');k=(k+1)%sl.length;sl[k].classList.add('on');dt[k]&&dt[k].classList.add('on')},5200)});
var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
if(RM||!window.gsap)return;
gsap.registerPlugin(ScrollTrigger);
var lenis=new Lenis({lerp:.1});
lenis.on('scroll',ScrollTrigger.update);
gsap.ticker.add(function(t){lenis.raf(t*1000)});gsap.ticker.lagSmoothing(0);
document.querySelectorAll('a[href^="#"]').forEach(function(a){a.addEventListener('click',function(e){var id=a.getAttribute('href');if(id.length>1){e.preventDefault();lenis.scrollTo(id,{offset:-70})}})});
var hero=document.body.dataset.hero, mm=gsap.matchMedia();
var SH={
 arch:['inset(15% 4% 0% 50% round 23vw 23vw 0 0)','inset(0% 0% 0% 0% round 0vw 0vw 0 0)',23],
 gable:['polygon(50% 34%, 72.5% 12%, 95% 34%, 95% 100%, 50% 100%)','polygon(0% 0%, 50% 0%, 100% 0%, 100% 100%, 0% 100%)',22.5],
 blob:['inset(13% 4% 9% 49% round 46% 54% 48% 52% / 56% 44% 56% 44%)','inset(0% 0% 0% 0% round 0% 0% 0% 0% / 0% 0% 0% 0%)',22.5],
 diag:['polygon(62% 0%, 100% 0%, 100% 100%, 46% 100%)','polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)',27]
};
if(hero==='mask'){
 var sec=document.querySelector('.h-mask'),sh=SH[sec.dataset.shape],box=sec.querySelector('.hm-img'),im=box.querySelector('.hm-in'),ht=sec.querySelector('.ht');
 mm.add('(min-width:901px)',function(){
  gsap.set(box,{clipPath:sh[0]});gsap.set(im,{xPercent:sh[2],scale:1.12});
  gsap.from(im,{scale:1.35,duration:1.1,ease:'expo.out'});
  var tl=gsap.timeline({scrollTrigger:{trigger:sec,start:'top top',end:'bottom bottom',scrub:.6}});
  tl.to(ht,{y:-80,opacity:0,duration:.35,ease:'none'},0).to(box,{clipPath:sh[1],duration:1,ease:'power2.inOut'},0).to(im,{xPercent:0,scale:1,duration:1,ease:'power2.inOut'},0);
 });
}
if(hero==='panes'){
 var hp=document.querySelector('.hp-img'),C=+hp.dataset.cols,R=+hp.dataset.rows,ms=[];
 for(var i=1;i<C;i++){var d=document.createElement('i');d.className='mull';d.style.cssText='left:'+(i*100/C)+'%;top:0;bottom:0;width:9px;margin-left:-4.5px';hp.appendChild(d);ms.push(d)}
 for(var j=1;j<R;j++){var e=document.createElement('i');e.className='mull';e.style.cssText='top:'+(j*100/R)+'%;left:0;right:0;height:9px;margin-top:-4.5px';hp.appendChild(e);ms.push(e)}
 var hi=hp.querySelector('.sl,.glassbg');
 gsap.from(hi,{scale:1.25,duration:1.2,ease:'expo.out'});
 gsap.from(ms,{scaleX:function(i,el){return el.style.width?1:0},scaleY:function(i,el){return el.style.width?0:1},transformOrigin:'0 0',duration:.7,stagger:.07,ease:'power3.out',delay:.1});
 gsap.to(hi,{yPercent:12,ease:'none',scrollTrigger:{trigger:hp,start:'top top',end:'bottom top',scrub:true}});
}
if(hero==='window'){
 mm.add('(min-width:901px)',function(){
  var w=document.querySelector('.win'),ht=document.querySelector('.h-win .ht'),wi=w.querySelector('.glass');
  gsap.from(w,{y:60,rotate:-2,duration:.9,ease:'expo.out'});
  var tl=gsap.timeline({scrollTrigger:{trigger:'.h-win',start:'top top',end:'bottom bottom',scrub:.6}});
  tl.to(ht,{x:-120,opacity:0,duration:.3},0).to(w,{scale:3.4,xPercent:-38,duration:1,ease:'power2.in'},0).to(wi,{scale:.9,duration:1},0);
 });
}
if(hero==='numerals'){
 var n=document.querySelector('.hn-num');
 gsap.from(n,{letterSpacing:'0.08em',opacity:0,duration:1,ease:'expo.out'});
 gsap.to(n,{backgroundPosition:'80% 50%',ease:'none',scrollTrigger:{trigger:n,start:'top bottom',end:'bottom top',scrub:true}});
}
if(hero==='portrait'){
 var p=document.querySelector('.hpo-p img'),cap=document.querySelector('.hpo-p figcaption');
 gsap.from('.hpo-p',{clipPath:'inset(100% 0 0 0)',duration:1,ease:'expo.out'});
 gsap.from(p,{scale:1.3,duration:1.3,ease:'expo.out'});
 gsap.from(cap,{yPercent:100,duration:.6,delay:.5,ease:'power3.out'});
 gsap.to(p,{yPercent:10,ease:'none',scrollTrigger:{trigger:'.h-por',start:'top top',end:'bottom top',scrub:true}});
}
if(hero==='collage'){
 var pr=document.querySelectorAll('.print');
 gsap.from(pr,{y:-120,opacity:0,rotate:function(i){return [-18,16,-10][i]},duration:.75,stagger:.09,ease:'back.out(1.4)'});
 pr.forEach(function(el,i){gsap.to(el,{y:[-60,40,-20][i],ease:'none',scrollTrigger:{trigger:'.h-col',start:'top top',end:'bottom top',scrub:true}})});
}
if(hero==='circuit'){
 var pa=document.querySelector('.cable path'),L=pa.getTotalLength();
 gsap.fromTo(pa,{strokeDasharray:L,strokeDashoffset:L},{strokeDashoffset:0,duration:1,ease:'power2.inOut'});
 gsap.from('.hc-img',{clipPath:'inset(0 100% 0 0)',duration:.9,ease:'expo.out',delay:.1});
 gsap.to('.wire i',{scaleY:1,ease:'none',scrollTrigger:{trigger:document.body,start:'top top',end:'bottom bottom',scrub:true}});
}
var pt=document.querySelector('.pin-track');
if(pt){mm.add('(min-width:901px)',function(){
  var dist=function(){return pt.scrollWidth-innerWidth};
  gsap.to(pt,{x:function(){return -dist()},ease:'none',scrollTrigger:{trigger:pt.parentNode,start:'top top',end:function(){return '+='+dist()},pin:true,scrub:.6,invalidateOnRefresh:true}});
});}
addEventListener('load',function(){ScrollTrigger.refresh()});
})();
