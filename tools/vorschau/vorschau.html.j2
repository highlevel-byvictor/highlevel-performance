<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow,noarchive">
<title>{{ f.firma }} – Entwurf</title>
<link rel="stylesheet" href="../../assets/fonts.css">
<style>
:root{--ink:#0B1630;--muted:#56627A;--line:#E3E8F1;--bg:#F6F8FC;--acc:{{ f.accent }};--acc2:{{ f.accent2 }};--navy:#0A1A3A}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:"Manrope","Segoe UI",Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:"Poppins","Helvetica Neue",Arial,sans-serif;line-height:1.1;letter-spacing:-.02em}
.pv{background:#0B1630;color:#fff;font-size:13px;text-align:center;padding:9px 16px}
.pv b{color:#38C8FF}
.nav{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:72px;gap:16px}
.brand{display:flex;align-items:center;gap:12px;font-family:"Poppins";font-weight:700;font-size:17px}
.brand img{height:44px;width:auto;max-width:170px;object-fit:contain}
.brand img.inv{filter:invert(1) brightness(.2)}
.links{display:flex;gap:28px;font-weight:600;font-size:15px;color:var(--muted)}
.links a:hover{color:var(--ink)}
.btn{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:15px;padding:14px 24px;border-radius:999px;transition:transform .15s;white-space:nowrap}
.btn:hover{transform:translateY(-2px)}
.btn-acc{background:var(--acc);color:#fff;box-shadow:0 10px 30px -12px var(--acc)}
.btn-line{border:1.5px solid rgba(255,255,255,.35);color:#fff}
.btn svg{width:18px;height:18px}
/* HERO: Text links, Bild rechts – nichts liegt über dem Bild */
.hero{background:var(--navy);color:#fff;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center;padding-top:56px;padding-bottom:56px}
.tag{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin-bottom:18px}
.tag i{width:8px;height:8px;border-radius:50%;background:var(--acc2)}
.hero h1{font-size:clamp(34px,4.6vw,58px);font-weight:800}
.hero h1 span{color:var(--acc2)}
.hero p{font-size:18px;margin:18px 0 30px;color:rgba(255,255,255,.78);max-width:480px}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.hero .pic{position:relative;border-radius:28px;overflow:hidden;aspect-ratio:4/3.1;box-shadow:0 40px 90px -30px rgba(0,0,0,.7)}
.hero .pic img{width:100%;height:100%;object-fit:cover;object-position:{{ f.hero_pos or 'center' }}}
.hero .pic:after{content:"";position:absolute;inset:0;border-radius:28px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}
.chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:34px}
.chips div{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.05);border-radius:14px;padding:10px 14px;font-size:13px;color:rgba(255,255,255,.7);line-height:1.3}
.chips b{display:block;font-family:"Poppins";font-size:17px;color:#fff}
section{padding:96px 0}
.kick{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--acc);margin-bottom:10px}
.sh{margin-bottom:40px}
.sh h2{font-size:clamp(30px,4vw,44px);font-weight:800}
/* Leistungen mit Bildern */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.svc{position:relative;border-radius:22px;overflow:hidden;background:#fff;border:1px solid var(--line);transition:transform .25s,box-shadow .25s}
.svc:hover{transform:translateY(-5px);box-shadow:0 28px 60px -30px rgba(11,22,48,.35)}
.svc .im{aspect-ratio:16/10;overflow:hidden}
.svc .im img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.svc:hover .im img{transform:scale(1.06)}
.svc h3{font-size:18px;font-weight:700;padding:18px 20px 20px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.svc h3:after{content:"→";color:var(--acc);font-size:20px}
/* Über uns */
.about{background:#fff}
.about .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:center}
.about .ph{border-radius:28px;overflow:hidden;aspect-ratio:5/4;box-shadow:0 40px 80px -40px rgba(11,22,48,.45)}
.about .ph img{width:100%;height:100%;object-fit:cover}
.about h2{font-size:clamp(30px,4vw,42px);font-weight:800;margin-bottom:16px}
.about p{color:var(--muted);font-size:17px}
.checks{list-style:none;margin-top:24px;display:grid;gap:12px}
.checks li{display:flex;gap:12px;font-weight:600;align-items:center}
.checks li:before{content:"✓";flex:none;width:26px;height:26px;border-radius:50%;background:var(--acc);color:#fff;display:grid;place-items:center;font-size:14px}
/* Galerie groß */
.gal{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:280px;gap:16px}
.gal div{border-radius:22px;overflow:hidden;background:#dde3ee}
.gal div:nth-child(1){grid-column:span 2;grid-row:span 2}
.gal img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.gal div:hover img{transform:scale(1.05)}
/* Kontakt */
.contact{background:var(--navy);color:#fff}
.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.contact h2{font-size:clamp(32px,4.4vw,50px);font-weight:800;margin-bottom:24px}
.ci{display:grid;gap:12px}
.ci a,.ci div{display:flex;gap:14px;align-items:center;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:16px 18px;font-weight:600}
.ci small{display:block;font-size:12px;color:rgba(255,255,255,.6);font-weight:500}
.ci svg{width:20px;height:20px;color:var(--acc2);flex:none}
.form{background:#fff;color:var(--ink);border-radius:24px;padding:30px;display:grid;gap:12px}
.form h3{font-size:22px;margin-bottom:4px}
.form input,.form textarea,.form select{width:100%;font:inherit;padding:14px 16px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}
.form textarea{min-height:100px;resize:vertical}
.form .note{font-size:12px;color:var(--muted)}
footer{background:#060E22;color:rgba(255,255,255,.6);font-size:14px;padding:32px 0}
footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
footer b{color:#fff}
.callbar{display:none}
@media(max-width:900px){
 .links{display:none}
 .nav .btn{padding:11px 16px;font-size:14px}
 .hero .wrap{grid-template-columns:1fr;gap:28px;padding-top:24px;padding-bottom:48px}
 .hero .pic{order:-1;aspect-ratio:4/3;border-radius:22px}
 .grid{grid-template-columns:1fr 1fr}
 .about .wrap,.contact .wrap{grid-template-columns:1fr;gap:32px}
 .gal{grid-template-columns:1fr 1fr;grid-auto-rows:180px}
}
@media(max-width:560px){
 section{padding:64px 0}
 .grid{grid-template-columns:1fr}
 .brand span{display:none}
 .hero p{font-size:16px}
 .callbar{display:flex;position:fixed;left:12px;right:12px;bottom:12px;z-index:30;justify-content:center;gap:10px;background:var(--acc);color:#fff;font-weight:800;padding:16px;border-radius:16px;box-shadow:0 16px 40px -12px rgba(0,0,0,.5)}
 footer{padding-bottom:96px}
}
</style>
</head>
<body>
<div class="pv"><b>Unverbindliche Vorschau</b> · erstellt von High Level Performance für {{ f.firma }}</div>

<header class="nav"><div class="wrap">
 <a class="brand" href="#top">{% if f.logo %}<img src="{{ f.logo }}" alt="{{ f.firma }}"{% if f.logo_invert %} class="inv"{% endif %}>{% endif %}<span>{{ f.kurzname }}</span></a>
 <nav class="links"><a href="#leistungen">Leistungen</a><a href="#ueber">Über uns</a>{% if f.galerie %}<a href="#projekte">Projekte</a>{% endif %}<a href="#kontakt">Kontakt</a></nav>
 {% if f.telefon %}<a class="btn btn-acc" href="tel:{{ f.tel_link }}">{{ icon_phone }}Anrufen</a>{% endif %}
</div></header>

<main id="top">
<section class="hero" style="padding:0"><div class="wrap">
 <div>
  <div class="tag"><i></i>{{ f.tag }}</div>
  <h1>{{ f.h1 | safe }}</h1>
  <p>{{ f.sub }}</p>
  <div class="cta">
   <a class="btn btn-acc" href="#kontakt">Anfrage stellen →</a>
   {% if f.telefon %}<a class="btn btn-line" href="tel:{{ f.tel_link }}">{{ icon_phone }}{{ f.telefon }}</a>{% endif %}
  </div>
  <div class="chips">{% for t in f.trust[:3] %}<div><b>{{ t[0] }}</b>{{ t[1] }}</div>{% endfor %}</div>
 </div>
 <div class="pic"><img src="{{ f.hero }}" alt="{{ f.firma }}"></div>
</div></section>

<section id="leistungen"><div class="wrap">
 <div class="sh"><div class="kick">Leistungen</div><h2>{{ f.leist_h2 }}</h2></div>
 <div class="grid">{% for l in f.leistungen %}<div class="svc"><div class="im"><img src="{{ f.imgs[loop.index0 % f.imgs|length] }}" alt="{{ l }}" loading="lazy"></div><h3>{{ l }}</h3></div>{% endfor %}</div>
</div></section>

<section class="about" id="ueber"><div class="wrap">
 <div class="ph"><img src="{{ f.about_img }}" alt="{{ f.firma }}" loading="lazy"></div>
 <div>
  <div class="kick">Über uns</div>
  <h2>{{ f.about_h2 }}</h2>
  <p>{{ f.ueber[0] }}</p>
  <ul class="checks">{% for c in f.checks %}<li>{{ c }}</li>{% endfor %}</ul>
 </div>
</div></section>

{% if f.galerie %}
<section id="projekte"><div class="wrap">
 <div class="sh"><div class="kick">Einblicke</div><h2>Aus unserer Arbeit</h2></div>
 <div class="gal">{% for g in f.galerie %}<div><img src="{{ g }}" alt="Projekt {{ loop.index }}" loading="lazy"></div>{% endfor %}</div>
</div></section>
{% endif %}

<section class="contact" id="kontakt"><div class="wrap">
 <div>
  <div class="kick" style="color:var(--acc2)">Kontakt</div>
  <h2>Sprechen Sie uns an.</h2>
  <div class="ci">
   {% if f.telefon %}<a href="tel:{{ f.tel_link }}">{{ icon_phone }}<span><small>Telefon</small>{{ f.telefon }}</span></a>{% endif %}
   {% if f.email %}<a href="mailto:{{ f.email }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m3 6 9 7 9-7"/></svg><span><small>E-Mail</small>{{ f.email }}</span></a>{% endif %}
   {% if f.adresse %}<div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg><span><small>Adresse</small>{{ f.adresse }}</span></div>{% endif %}
  </div>
 </div>
 <form class="form" onsubmit="event.preventDefault();this.querySelector('.note').textContent='In der Vorschau ist das Formular noch nicht aktiv.'">
  <h3>Unverbindlich anfragen</h3>
  <input placeholder="Ihr Name" required>
  <input placeholder="Telefon oder E-Mail" required>
  <select><option>Worum geht es?</option>{% for l in f.leistungen %}<option>{{ l }}</option>{% endfor %}</select>
  <textarea placeholder="Was haben Sie vor?"></textarea>
  <button class="btn btn-acc" style="justify-content:center;border:0;cursor:pointer">Anfrage senden</button>
  <div class="note">Wir melden uns schnellstmöglich.</div>
 </form>
</div></section>
</main>

<footer><div class="wrap">
 <div><b>{{ f.firma }}</b>{% if f.adresse %} · {{ f.adresse }}{% endif %}</div>
 <div>Entwurf von <b>High Level Performance</b> · Inhalte und Bilder von {{ f.website_kurz }}</div>
</div></footer>
{% if f.telefon %}<a class="callbar" href="tel:{{ f.tel_link }}">{{ icon_phone }}Jetzt anrufen</a>{% endif %}
</body>
</html>
